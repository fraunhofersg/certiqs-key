digraph claims {
  rankdir=LR;
  graph [label="2 Feasible states and licensed constraints\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_protocol-compiler" {
    label="protocol-compiler"; color="#cbd5df";
    "protocol-compiler/def:declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:declaration<BR/>Protocol declaration<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-declaration.tex", target="_top"];
    "protocol-compiler/def:exact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:exact<BR/>Exact admissibility of declared<BR/>operator data<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exact.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:exact" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-exact.tex", target="_top"];
    "protocol-compiler/def:feasible" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:feasible<BR/>Feasible set<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-feasible.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:feasible" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-feasible.tex", target="_top"];
    "protocol-compiler/def:homog" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:homog<BR/>Licensed constraint list<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-homog.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:homog" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-homog.tex", target="_top"];
    "protocol-compiler/def:target" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:target<BR/>Target conditions of a well-formed<BR/>declaration<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-target.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:target" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-target.tex", target="_top"];
    "protocol-compiler/ex:two-party-shape" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/ex:two-party-shape<BR/>Declaration of a two-party protocol<BR/>with an untrusted source<BR/>accepted</TD></TR><TR><TD HREF="../claims/ex-two-party-shape.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/ex:two-party-shape" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ex-two-party-shape.tex", target="_top"];
    "protocol-compiler/lem:hermitian-constraint-values" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/lem:hermitian-constraint-values<BR/>Hermiticity of the constraint values<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-hermitian-constraint-values.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/lem:hermitian-constraint-values" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-hermitian-constraint-values.tex", target="_top"];
    "protocol-compiler/rem:block-restriction" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:block-restriction<BR/>Restriction of the feasible set to<BR/>block-diagonal states<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-block-restriction.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:block-restriction" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-block-restriction.tex", target="_top"];
    "protocol-compiler/rem:party-local-soundness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:party-local-soundness<BR/>Soundness of a party-local entry<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-party-local-soundness.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:party-local-soundness" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-party-local-soundness.tex", target="_top"];
    "protocol-compiler/rem:wellposed" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:wellposed<BR/>Hermiticity as a declared condition<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-wellposed.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:wellposed" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-wellposed.tex", target="_top"];
  }
  "protocol-compiler/def:feasible" -> "protocol-compiler/def:declaration";
  "protocol-compiler/def:feasible" -> "protocol-compiler/def:exact";
  "protocol-compiler/def:homog" -> "protocol-compiler/def:declaration";
  "protocol-compiler/def:homog" -> "protocol-compiler/def:feasible";
  "protocol-compiler/lem:hermitian-constraint-values" -> "protocol-compiler/def:declaration";
  "protocol-compiler/lem:hermitian-constraint-values" -> "protocol-compiler/def:feasible";
  "protocol-compiler/lem:hermitian-constraint-values" -> "protocol-compiler/def:target";
  "protocol-compiler/rem:block-restriction" -> "protocol-compiler/def:feasible";
  "protocol-compiler/rem:party-local-soundness" -> "protocol-compiler/def:homog";
  "protocol-compiler/rem:wellposed" -> "protocol-compiler/def:declaration";
  "protocol-compiler/rem:wellposed" -> "protocol-compiler/def:feasible";
  "protocol-compiler/rem:wellposed" -> "protocol-compiler/lem:hermitian-constraint-values";
}
