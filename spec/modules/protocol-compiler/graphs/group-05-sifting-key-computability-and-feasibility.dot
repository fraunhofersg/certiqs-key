    "protocol-compiler/rem:nosearch" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:nosearch<BR/>Feasibility by witness rather than by<BR/>search<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-nosearch.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:nosearch" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-nosearch.tex", target="_top"];
    "protocol-compiler/rem:sidecond" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:sidecond<BR/>Necessity of the key-rule side<BR/>condition<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-sidecond.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:sidecond" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-sidecond.tex", target="_top"];
    "protocol-compiler/rem:vacuous" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:vacuous<BR/>Party computability read against the<BR/>readouts<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-vacuous.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:vacuous" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-vacuous.tex", target="_top"];
    "protocol-compiler/thm:feasibility" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/thm:feasibility<BR/>Feasibility by an explicit or a<BR/>verified candidate<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-feasibility.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/thm:feasibility" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-feasibility.tex", target="_top"];
    "protocol-compiler/thm:sifting-and-key" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/thm:sifting-and-key<BR/>Announcement locality, sifting and<BR/>party computability<BR/>accepted</TD></TR><TR><TD HREF="../claims/thm-sifting-and-key.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/thm:sifting-and-key" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/thm-sifting-and-key.tex", target="_top"];
