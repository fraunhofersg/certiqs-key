digraph claims {
  rankdir=LR;
  graph [label="9 The emission gates\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_protocol-compiler" {
    label="protocol-compiler"; color="#cbd5df";
    "protocol-compiler/ass:atk" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/ass:atk<BR/>Attack-set licence<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-atk.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/ass:atk" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-atk.tex", target="_top"];
    "protocol-compiler/ass:rhom" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/ass:rhom<BR/>Round homogeneity of the declaration<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-rhom.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/ass:rhom" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-rhom.tex", target="_top"];
    "protocol-compiler/def:compile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:compile<BR/>The compilation map<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-compile.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:compile" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-compile.tex", target="_top"];
    "protocol-compiler/def:declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:declaration<BR/>Protocol declaration<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-declaration.tex", target="_top"];
    "protocol-compiler/def:eligible" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:eligible<BR/>Key-length eligibility<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-eligible.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:eligible" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-eligible.tex", target="_top"];
    "protocol-compiler/def:exact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:exact<BR/>Exact admissibility of declared<BR/>operator data<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exact.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:exact" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-exact.tex", target="_top"];
    "protocol-compiler/def:feasible" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:feasible<BR/>Feasible set<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-feasible.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:feasible" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-feasible.tex", target="_top"];
    "protocol-compiler/def:gate-outcome-table" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:gate-outcome-table<BR/>The gate outcome table<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-gate-outcome-table.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:gate-outcome-table" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-gate-outcome-table.tex", target="_top"];
    "protocol-compiler/def:homog" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:homog<BR/>Licensed constraint list<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-homog.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:homog" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-homog.tex", target="_top"];
    "protocol-compiler/def:spec" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:spec<BR/>Protocol specification<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-spec.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:spec" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-spec.tex", target="_top"];
    "protocol-compiler/lem:hermitian-constraint-values" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/lem:hermitian-constraint-values<BR/>Hermiticity of the constraint values<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-hermitian-constraint-values.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/lem:hermitian-constraint-values" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-hermitian-constraint-values.tex", target="_top"];
    "protocol-compiler/prop:conservative" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/prop:conservative<BR/>Dropping a trusted marginal enlarges<BR/>the feasible set<BR/>accepted</TD></TR><TR><TD HREF="../claims/prop-conservative.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/prop:conservative" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/prop-conservative.tex", target="_top"];
    "protocol-compiler/rem:degenerate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:degenerate<BR/>The licensed-class gate in untrusted-<BR/>source mode and at d_A=1<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-degenerate.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:degenerate" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-degenerate.tex", target="_top"];
    "protocol-compiler/rem:gate-by-certificate-form" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:gate-by-certificate-form<BR/>The source gate on each certificate<BR/>form<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-gate-by-certificate-form.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:gate-by-certificate-form" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-gate-by-certificate-form.tex", target="_top"];
    "protocol-compiler/rem:notfallback" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/rem:notfallback<BR/>Dropping a marginal, never replacing<BR/>it<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-notfallback.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/rem:notfallback" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-notfallback.tex", target="_top"];
    "protocol-compiler/thm:gates" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/thm:gates<BR/>The emission gates and their outcomes<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-gates.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/thm:gates" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-gates.tex", target="_top"];
    "protocol-compiler/thm:validator-soundness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/thm:validator-soundness<BR/>Soundness, completeness and<BR/>decidability of the validator<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-validator-soundness.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/thm:validator-soundness" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-validator-soundness.tex", target="_top"];
  }
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/def:source-spec" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-spec<BR/>Source specification<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../transmitter/claims/def-source-spec.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../transmitter/contract.pdf#nameddest=claim-transmitter/def:source-spec" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../transmitter/claims/def-source-spec.tex", target="_top"];
    "transmitter/def:srcert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:srcert<BR/>Source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../transmitter/claims/def-srcert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../transmitter/contract.pdf#nameddest=claim-transmitter/def:srcert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../transmitter/claims/def-srcert.tex", target="_top"];
    "transmitter/thm:certificate-sufficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/thm:certificate-sufficiency<BR/>Checkability and sufficiency of the<BR/>source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../transmitter/claims/thm-certificate-sufficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../transmitter/contract.pdf#nameddest=claim-transmitter/thm:certificate-sufficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../transmitter/claims/thm-certificate-sufficiency.tex", target="_top"];
  }
  "protocol-compiler/def:eligible" -> "protocol-compiler/def:declaration";
  "protocol-compiler/def:eligible" -> "protocol-compiler/def:exact";
  "protocol-compiler/def:eligible" -> "protocol-compiler/def:homog";
  "protocol-compiler/def:eligible" -> "protocol-compiler/thm:validator-soundness";
  "protocol-compiler/def:eligible" -> "transmitter/def:srcert";
  "protocol-compiler/def:eligible" -> "transmitter/thm:certificate-sufficiency";
  "protocol-compiler/def:gate-outcome-table" -> "protocol-compiler/def:eligible";
  "protocol-compiler/prop:conservative" -> "protocol-compiler/def:exact";
  "protocol-compiler/prop:conservative" -> "protocol-compiler/def:feasible";
  "protocol-compiler/prop:conservative" -> "protocol-compiler/def:homog";
  "protocol-compiler/prop:conservative" -> "protocol-compiler/lem:hermitian-constraint-values";
  "protocol-compiler/rem:gate-by-certificate-form" -> "protocol-compiler/def:eligible";
  "protocol-compiler/rem:notfallback" -> "protocol-compiler/prop:conservative";
  "protocol-compiler/rem:notfallback" -> "protocol-compiler/thm:gates";
  "protocol-compiler/thm:gates" -> "protocol-compiler/ass:atk" [style=dashed, color="#a35f13", tooltip="assumes"];
  "protocol-compiler/thm:gates" -> "protocol-compiler/ass:rhom" [style=dashed, color="#a35f13", tooltip="assumes"];
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:compile";
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:declaration";
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:eligible";
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:exact";
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:gate-outcome-table";
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:homog";
  "protocol-compiler/thm:gates" -> "protocol-compiler/def:spec";
  "protocol-compiler/thm:gates" -> "protocol-compiler/thm:validator-soundness";
  "protocol-compiler/thm:gates" -> "transmitter/def:source-spec";
  "protocol-compiler/thm:gates" -> "transmitter/thm:certificate-sufficiency";
