digraph claims {
  rankdir=LR;
  graph [label="8 The Band-A route\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_protocol-compiler" {
    label="protocol-compiler"; color="#cbd5df";
    "protocol-compiler/ass:ideal" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/ass:ideal<BR/>Ideal qubit receiver on the Band-A<BR/>route<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-ideal.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/ass:ideal" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-ideal.tex", target="_top"];
    "protocol-compiler/def:banda" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:banda<BR/>Band-A specification<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-banda.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:banda" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-banda.tex", target="_top"];
    "protocol-compiler/def:chaincond" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:chaincond<BR/>Interface conditions on a chain<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-chaincond.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:chaincond" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-chaincond.tex", target="_top"];
    "protocol-compiler/def:compile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:compile<BR/>The compilation map<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-compile.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:compile" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-compile.tex", target="_top"];
    "protocol-compiler/def:exact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:exact<BR/>Exact admissibility of declared<BR/>operator data<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exact.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:exact" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-exact.tex", target="_top"];
    "protocol-compiler/def:weighted" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:weighted<BR/>Choice-weighted families<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-weighted.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:weighted" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-weighted.tex", target="_top"];
    "protocol-compiler/thm:band-a" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/thm:band-a<BR/>The Band-A route<BR/>accepted</TD></TR><TR><TD HREF="../claims/thm-band-a.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/thm:band-a" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/thm-band-a.tex", target="_top"];
  }
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/def:source-segment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-segment<BR/>Source segment and its interface<BR/>conditions<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../transmitter/claims/def-source-segment.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../transmitter/contract.pdf#nameddest=claim-transmitter/def:source-segment" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../transmitter/claims/def-source-segment.tex", target="_top"];
  }
  "protocol-compiler/def:banda" -> "transmitter/def:source-segment";
  "protocol-compiler/thm:band-a" -> "protocol-compiler/ass:ideal" [style=dashed, color="#a35f13", tooltip="assumes"];
  "protocol-compiler/thm:band-a" -> "protocol-compiler/def:banda";
  "protocol-compiler/thm:band-a" -> "protocol-compiler/def:chaincond";
  "protocol-compiler/thm:band-a" -> "protocol-compiler/def:compile";
  "protocol-compiler/thm:band-a" -> "protocol-compiler/def:exact";
  "protocol-compiler/thm:band-a" -> "protocol-compiler/def:weighted";
  "protocol-compiler/thm:band-a" -> "transmitter/def:source-segment";
}
