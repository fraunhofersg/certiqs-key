  "protocol-compiler/thm:chain-consumption" -> "protocol-compiler/def:declaration";
  "protocol-compiler/thm:chain-consumption" -> "protocol-compiler/def:exact";
  "protocol-compiler/thm:chain-consumption" -> "protocol-compiler/def:spec";
  "protocol-compiler/thm:chain-consumption" -> "protocol-compiler/def:target";
  "protocol-compiler/thm:chain-consumption" -> "protocol-compiler/def:validator";
