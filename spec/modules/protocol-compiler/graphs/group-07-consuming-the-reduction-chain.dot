  "protocol-compiler/rem:chain-and-validator" -> "protocol-compiler/def:validator";
  "protocol-compiler/rem:chain-and-validator" -> "protocol-compiler/thm:feasibility";
  "protocol-compiler/rem:chaincond-reductions" -> "protocol-compiler/def:chaincond";
