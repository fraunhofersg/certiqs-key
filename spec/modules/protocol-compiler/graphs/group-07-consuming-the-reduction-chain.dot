  "protocol-compiler/def:chaincond" -> "protocol-compiler/def:exact";
  "protocol-compiler/def:chaincond" -> "protocol-compiler/def:validator";
  "protocol-compiler/def:chaincond" -> "transmitter/def:source-segment";
  "protocol-compiler/rem:chain-and-validator" -> "protocol-compiler/def:chaincond";
