digraph claims {
  rankdir=LR;
  graph [label="12 Requirements: choice weighting\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_protocol-compiler" {
    label="protocol-compiler"; color="#cbd5df";
    "protocol-compiler/def:compile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:compile<BR/>The compilation map<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-compile.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:compile" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-compile.tex", target="_top"];
    "protocol-compiler/def:weighted" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:weighted<BR/>Choice-weighted families<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-weighted.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/def:weighted" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-weighted.tex", target="_top"];
    "protocol-compiler/req:binary64-weights" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:binary64-weights<BR/>Declared weights as binary64 input<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-binary64-weights.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:binary64-weights" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-binary64-weights.tex", target="_top"];
    "protocol-compiler/req:conditional-family-decision" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:conditional-family-decision<BR/>Decision on each declared conditional<BR/>family<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-conditional-family-decision.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:conditional-family-decision" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-conditional-family-decision.tex", target="_top"];
    "protocol-compiler/req:no-fixed-fraction" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:no-fixed-fraction<BR/>No fixed fraction outside the<BR/>measurement operators<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-no-fixed-fraction.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:no-fixed-fraction" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-no-fixed-fraction.tex", target="_top"];
    "protocol-compiler/req:no-lattice-exponent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:no-lattice-exponent<BR/>No lattice exponent and no snapping of<BR/>the emission<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-no-lattice-exponent.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:no-lattice-exponent" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-no-lattice-exponent.tex", target="_top"];
    "protocol-compiler/req:setting-only-weighting" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:setting-only-weighting<BR/>Setting-dependent weighting read<BR/>through the setting only<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-setting-only-weighting.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:setting-only-weighting" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-setting-only-weighting.tex", target="_top"];
    "protocol-compiler/req:stochastic-weights" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:stochastic-weights<BR/>Stochastic matrix of a setting-<BR/>dependent weighting<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-stochastic-weights.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:stochastic-weights" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-stochastic-weights.tex", target="_top"];
    "protocol-compiler/req:weight-list" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:weight-list<BR/>Decision on the declared weight list<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-weight-list.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:weight-list" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-weight-list.tex", target="_top"];
    "protocol-compiler/req:weight-preparation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:weight-preparation<BR/>Preparation of user weights before the<BR/>module boundary<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-weight-preparation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:weight-preparation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-weight-preparation.tex", target="_top"];
    "protocol-compiler/req:weighted-family-emission" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/req:weighted-family-emission<BR/>Emission decisions on the weighted<BR/>products<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-weighted-family-emission.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/req:weighted-family-emission" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-weighted-family-emission.tex", target="_top"];
    "protocol-compiler/thm:choice-encoding" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/thm:choice-encoding<BR/>Encoding of public choices in the<BR/>measurement operators<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-choice-encoding.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-protocol-compiler/thm:choice-encoding" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-choice-encoding.tex", target="_top"];
  }
  "protocol-compiler/req:binary64-weights" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:conditional-family-decision" -> "protocol-compiler/def:compile";
  "protocol-compiler/req:conditional-family-decision" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:no-fixed-fraction" -> "protocol-compiler/thm:choice-encoding";
  "protocol-compiler/req:no-lattice-exponent" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:setting-only-weighting" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:setting-only-weighting" -> "protocol-compiler/thm:choice-encoding";
  "protocol-compiler/req:stochastic-weights" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:stochastic-weights" -> "protocol-compiler/thm:choice-encoding";
  "protocol-compiler/req:weight-list" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:weight-preparation" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:weighted-family-emission" -> "protocol-compiler/def:weighted";
  "protocol-compiler/req:weighted-family-emission" -> "protocol-compiler/thm:choice-encoding";
}
