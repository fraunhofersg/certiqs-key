digraph claims {
  rankdir=LR;
  graph [label="7 Decoy-state sources and the tagging channel: The source model and the tagged declaration\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/def:source-link" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-link<BR/>Source link<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-link.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-link" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-link.tex", target="_top"];
    "transmitter/def:source-segment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-segment<BR/>Source segment and its interface<BR/>conditions<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-segment.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-segment" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-segment.tex", target="_top"];
    "transmitter/def:source-spec" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-spec<BR/>Source specification<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-spec.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-spec" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-spec.tex", target="_top"];
  }
  subgraph "cluster_transmitter/decoy" {
    label="transmitter/decoy"; color="#cbd5df";
    "transmitter/decoy/def:tagged-source" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/def:tagged-source<BR/>Tagged virtual source: cutoffs, flags<BR/>and sector map<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/def-tagged-source.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/def:tagged-source" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/def-tagged-source.tex", target="_top"];
    "transmitter/decoy/def:wcp-model" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/def:wcp-model<BR/>Phase-randomised weak-coherent-pulse<BR/>source model<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/def-wcp-model.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/def:wcp-model" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/def-wcp-model.tex", target="_top"];
    "transmitter/decoy/lem:poisson-enclosure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/lem:poisson-enclosure<BR/>Rational enclosure of the Poisson<BR/>weights<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/lem-poisson-enclosure.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/lem:poisson-enclosure" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/lem-poisson-enclosure.tex", target="_top"];
    "transmitter/decoy/rem:cutoffs" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/rem:cutoffs<BR/>Entropy, source and receiver cutoffs<BR/>accepted</TD></TR><TR><TD HREF="../decoy/claims/rem-cutoffs.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/rem:cutoffs" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../decoy/claims/rem-cutoffs.tex", target="_top"];
  }
  "transmitter/decoy/def:tagged-source" -> "transmitter/decoy/def:wcp-model";
  "transmitter/decoy/def:tagged-source" -> "transmitter/def:source-link";
  "transmitter/decoy/def:tagged-source" -> "transmitter/def:source-segment";
  "transmitter/decoy/def:wcp-model" -> "transmitter/def:source-spec";
  "transmitter/decoy/lem:poisson-enclosure" -> "transmitter/decoy/def:wcp-model";
  "transmitter/decoy/rem:cutoffs" -> "transmitter/decoy/def:tagged-source";
}
