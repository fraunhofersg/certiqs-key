digraph claims {
  rankdir=LR;
  graph [label="9 Decoy-state sources and the tagging channel: The certificate and the emitted declaration\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/ass:seq" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/ass:seq<BR/>Sequential round structure<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-seq.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/ass:seq" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-seq.tex", target="_top"];
    "transmitter/ass:src" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/ass:src<BR/>Retention of the system A in trusted-<BR/>source mode<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-src.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/ass:src" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-src.tex", target="_top"];
    "transmitter/def:source-link" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-link<BR/>Source link<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-link.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-link" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-link.tex", target="_top"];
    "transmitter/def:source-segment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-segment<BR/>Source segment and its interface<BR/>conditions<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-segment.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-segment" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-segment.tex", target="_top"];
    "transmitter/def:source-spec" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-spec<BR/>Source specification<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-spec.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-spec" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-spec.tex", target="_top"];
    "transmitter/def:srcert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:srcert<BR/>Source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-srcert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:srcert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-srcert.tex", target="_top"];
    "transmitter/lem:ensemble-presentation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/lem:ensemble-presentation<BR/>Certificate defined by an ensemble<BR/>presentation<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-ensemble-presentation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/lem:ensemble-presentation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-ensemble-presentation.tex", target="_top"];
    "transmitter/lem:matched-pinching" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/lem:matched-pinching<BR/>Matched pinching of a block<BR/>certificate<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-matched-pinching.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/lem:matched-pinching" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-matched-pinching.tex", target="_top"];
    "transmitter/thm:certificate-sufficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/thm:certificate-sufficiency<BR/>Checkability and sufficiency of the<BR/>source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-certificate-sufficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/thm:certificate-sufficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-certificate-sufficiency.tex", target="_top"];
  }
  subgraph "cluster_transmitter/decoy" {
    label="transmitter/decoy"; color="#cbd5df";
    "transmitter/decoy/ass:wcp" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/ass:wcp<BR/>Emission of the declared weak-<BR/>coherent-pulse states<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/ass-wcp.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/ass:wcp" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../decoy/claims/ass-wcp.tex", target="_top"];
    "transmitter/decoy/cor:emitted-decoy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/cor:emitted-decoy<BR/>The emitted decoy declaration<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/cor-emitted-decoy.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/cor:emitted-decoy" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/cor-emitted-decoy.tex", target="_top"];
    "transmitter/decoy/def:tagged-source" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/def:tagged-source<BR/>Tagged virtual source: cutoffs, flags<BR/>and sector map<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/def-tagged-source.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/def:tagged-source" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/def-tagged-source.tex", target="_top"];
    "transmitter/decoy/def:wcp-model" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/def:wcp-model<BR/>Phase-randomised weak-coherent-pulse<BR/>source model<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/def-wcp-model.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/def:wcp-model" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/def-wcp-model.tex", target="_top"];
    "transmitter/decoy/prop:decoy-cert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/prop:decoy-cert<BR/>Ensemble presentation of the tagged<BR/>source<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/prop-decoy-cert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/prop:decoy-cert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/prop-decoy-cert.tex", target="_top"];
    "transmitter/decoy/prop:tagging" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/prop:tagging<BR/>Tagging channel for weights at or<BR/>below the Poisson weights<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/prop-tagging.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/prop:tagging" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../decoy/claims/prop-tagging.tex", target="_top"];
    "transmitter/decoy/rem:decoy-consumers" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/rem:decoy-consumers<BR/>Consumers of the emitted decoy<BR/>declaration<BR/>accepted</TD></TR><TR><TD HREF="../decoy/claims/rem-decoy-consumers.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/rem:decoy-consumers" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../decoy/claims/rem-decoy-consumers.tex", target="_top"];
    "transmitter/decoy/req:decoy-emission" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:decoy-emission<BR/>Emission of the tagged ensemble as<BR/>declared<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/req-decoy-emission.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:decoy-emission" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/req-decoy-emission.tex", target="_top"];
  }
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/ass:seq" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/ass:src" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/decoy/ass:wcp" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/decoy/def:wcp-model";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/decoy/prop:decoy-cert";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/decoy/prop:tagging";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/def:source-link";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/def:source-segment";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/def:source-spec";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/def:srcert";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/lem:ensemble-presentation";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/lem:matched-pinching";
  "transmitter/decoy/cor:emitted-decoy" -> "transmitter/thm:certificate-sufficiency";
  "transmitter/decoy/prop:decoy-cert" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/prop:decoy-cert" -> "transmitter/decoy/def:wcp-model";
  "transmitter/decoy/prop:decoy-cert" -> "transmitter/def:srcert";
  "transmitter/decoy/prop:decoy-cert" -> "transmitter/lem:ensemble-presentation";
  "transmitter/decoy/rem:decoy-consumers" -> "transmitter/decoy/cor:emitted-decoy";
  "transmitter/decoy/rem:decoy-consumers" -> "transmitter/decoy/req:decoy-emission";
}
