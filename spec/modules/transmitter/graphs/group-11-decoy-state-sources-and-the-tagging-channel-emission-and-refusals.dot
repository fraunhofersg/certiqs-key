digraph claims {
  rankdir=LR;
  graph [label="11 Decoy-state sources and the tagging channel: Emission and refusals\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/def:srcert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:srcert<BR/>Source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-srcert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:srcert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-srcert.tex", target="_top"];
  }
  subgraph "cluster_transmitter/decoy" {
    label="transmitter/decoy"; color="#cbd5df";
    "transmitter/decoy/cor:emitted-decoy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/cor:emitted-decoy<BR/>The emitted decoy declaration<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/cor-emitted-decoy.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/cor:emitted-decoy" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/cor-emitted-decoy.tex", target="_top"];
    "transmitter/decoy/def:tagged-source" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/def:tagged-source<BR/>Tagged virtual source: cutoffs, flags<BR/>and sector map<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/def-tagged-source.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/def:tagged-source" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/def-tagged-source.tex", target="_top"];
    "transmitter/decoy/def:wcp-model" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/def:wcp-model<BR/>Phase-randomised weak-coherent-pulse<BR/>source model<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/def-wcp-model.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/def:wcp-model" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/def-wcp-model.tex", target="_top"];
    "transmitter/decoy/lem:poisson-enclosure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/lem:poisson-enclosure<BR/>Rational enclosure of the Poisson<BR/>weights<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/lem-poisson-enclosure.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/lem:poisson-enclosure" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../decoy/claims/lem-poisson-enclosure.tex", target="_top"];
    "transmitter/decoy/prop:tagging" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/prop:tagging<BR/>Tagging channel for weights at or<BR/>below the Poisson weights<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../decoy/claims/prop-tagging.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/prop:tagging" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../decoy/claims/prop-tagging.tex", target="_top"];
    "transmitter/decoy/req:cutoff-order" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:cutoff-order<BR/>Order of the entropy and source<BR/>cutoffs<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-cutoff-order.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:cutoff-order" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-cutoff-order.tex", target="_top"];
    "transmitter/decoy/req:decoy-emission" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:decoy-emission<BR/>Emission of the tagged ensemble as<BR/>declared<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-decoy-emission.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:decoy-emission" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-decoy-emission.tex", target="_top"];
    "transmitter/decoy/req:decoy-ensemble-conditions" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:decoy-ensemble-conditions<BR/>Positivity and weight sums of the<BR/>emitted blocks<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-decoy-ensemble-conditions.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:decoy-ensemble-conditions" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-decoy-ensemble-conditions.tex", target="_top"];
    "transmitter/decoy/req:entropy-cutoff" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:entropy-cutoff<BR/>Entropy cutoff of at most two photons<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-entropy-cutoff.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:entropy-cutoff" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-entropy-cutoff.tex", target="_top"];
    "transmitter/decoy/req:exact-decoy-blocks" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:exact-decoy-blocks<BR/>Binary64 entries of the emitted blocks<BR/>and sector sums<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-exact-decoy-blocks.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:exact-decoy-blocks" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-exact-decoy-blocks.tex", target="_top"];
    "transmitter/decoy/req:sector-weight-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:sector-weight-bound<BR/>Certified bound on the sector weights<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-sector-weight-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:sector-weight-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-sector-weight-bound.tex", target="_top"];
    "transmitter/decoy/req:shared-flags" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:shared-flags<BR/>Shared polarisation and tail flags<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-shared-flags.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:shared-flags" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-shared-flags.tex", target="_top"];
    "transmitter/decoy/req:signal-dyads" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/decoy/req:signal-dyads<BR/>Signal dyads formed by the exhibited<BR/>construction<BR/>implemented</TD></TR><TR><TD HREF="../decoy/claims/req-signal-dyads.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/decoy/req:signal-dyads" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../decoy/claims/req-signal-dyads.tex", target="_top"];
  }
  "transmitter/decoy/req:cutoff-order" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/req:decoy-emission" -> "transmitter/decoy/cor:emitted-decoy";
  "transmitter/decoy/req:decoy-emission" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/req:decoy-ensemble-conditions" -> "transmitter/decoy/cor:emitted-decoy";
  "transmitter/decoy/req:decoy-ensemble-conditions" -> "transmitter/def:srcert";
  "transmitter/decoy/req:entropy-cutoff" -> "transmitter/decoy/cor:emitted-decoy";
  "transmitter/decoy/req:exact-decoy-blocks" -> "transmitter/decoy/cor:emitted-decoy";
  "transmitter/decoy/req:exact-decoy-blocks" -> "transmitter/def:srcert";
  "transmitter/decoy/req:sector-weight-bound" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/req:sector-weight-bound" -> "transmitter/decoy/lem:poisson-enclosure";
  "transmitter/decoy/req:sector-weight-bound" -> "transmitter/decoy/prop:tagging";
  "transmitter/decoy/req:shared-flags" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/req:signal-dyads" -> "transmitter/decoy/cor:emitted-decoy";
  "transmitter/decoy/req:signal-dyads" -> "transmitter/decoy/def:tagged-source";
  "transmitter/decoy/req:signal-dyads" -> "transmitter/decoy/def:wcp-model";
}
