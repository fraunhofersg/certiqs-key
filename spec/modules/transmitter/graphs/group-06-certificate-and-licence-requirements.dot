digraph claims {
  rankdir=LR;
  graph [label="6 Certificate and licence requirements\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/def:srcert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:srcert<BR/>Source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-srcert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:srcert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-srcert.tex", target="_top"];
    "transmitter/rem:boundary" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/rem:boundary<BR/>Scope of a verified certificate<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-boundary.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/rem:boundary" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-boundary.tex", target="_top"];
    "transmitter/rem:da1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/rem:da1<BR/>The one-dimensional retained system<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-da1.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/rem:da1" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-da1.tex", target="_top"];
    "transmitter/req:attestation-record" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/req:attestation-record<BR/>Pass-through of the retention<BR/>attestation<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-attestation-record.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/req:attestation-record" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-attestation-record.tex", target="_top"];
    "transmitter/req:failing-certificate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/req:failing-certificate<BR/>Refusal of a certificate that fails a<BR/>decided condition<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-failing-certificate.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/req:failing-certificate" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-failing-certificate.tex", target="_top"];
    "transmitter/req:licence-scope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/req:licence-scope<BR/>Certificate and attestation demanded<BR/>only at d_A≥2<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-licence-scope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/req:licence-scope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-licence-scope.tex", target="_top"];
    "transmitter/req:marginal-decided" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/req:marginal-decided<BR/>Direct decision of the declared<BR/>marginal<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-marginal-decided.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/req:marginal-decided" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-marginal-decided.tex", target="_top"];
    "transmitter/req:marginal-fill" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/req:marginal-fill<BR/>The unique marginal served at d_A=1<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-marginal-fill.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/req:marginal-fill" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-marginal-fill.tex", target="_top"];
    "transmitter/thm:certificate-sufficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/thm:certificate-sufficiency<BR/>Checkability and sufficiency of the<BR/>source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-certificate-sufficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/thm:certificate-sufficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-certificate-sufficiency.tex", target="_top"];
  }
  "transmitter/req:attestation-record" -> "transmitter/rem:boundary";
  "transmitter/req:attestation-record" -> "transmitter/req:licence-scope";
  "transmitter/req:attestation-record" -> "transmitter/thm:certificate-sufficiency";
  "transmitter/req:failing-certificate" -> "transmitter/def:srcert";
  "transmitter/req:failing-certificate" -> "transmitter/rem:da1";
  "transmitter/req:licence-scope" -> "transmitter/def:srcert";
  "transmitter/req:licence-scope" -> "transmitter/rem:da1";
  "transmitter/req:marginal-decided" -> "transmitter/thm:certificate-sufficiency";
  "transmitter/req:marginal-fill" -> "transmitter/rem:da1";
}
