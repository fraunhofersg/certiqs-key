digraph claims {
  rankdir=LR;
  graph [label="4 Sufficiency of the certificate and its scope\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_transmitter" {
    label="transmitter"; color="#cbd5df";
    "transmitter/ass:seq" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/ass:seq<BR/>Sequential round structure<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-seq.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/ass:seq" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-seq.tex", target="_top"];
    "transmitter/ass:src" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/ass:src<BR/>Retention of the system A in trusted-<BR/>source mode<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-src.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/ass:src" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-src.tex", target="_top"];
    "transmitter/cor:noncanonical" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/cor:noncanonical<BR/>Certificates beyond the canonical form<BR/>accepted</TD></TR><TR><TD HREF="../claims/cor-noncanonical.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/cor:noncanonical" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/cor-noncanonical.tex", target="_top"];
    "transmitter/def:source-segment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-segment<BR/>Source segment and its interface<BR/>conditions<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-segment.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-segment" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-segment.tex", target="_top"];
    "transmitter/def:source-spec" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:source-spec<BR/>Source specification<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-source-spec.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:source-spec" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-source-spec.tex", target="_top"];
    "transmitter/def:srcert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/def:srcert<BR/>Source-replacement certificate<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-srcert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/def:srcert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-srcert.tex", target="_top"];
    "transmitter/fact:sr" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/fact:sr<BR/>Source replacement for prepare-and-<BR/>measure protocols<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/fact-sr.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/fact:sr" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/fact-sr.tex", target="_top"];
    "transmitter/lem:ensemble-presentation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/lem:ensemble-presentation<BR/>Certificate defined by an ensemble<BR/>presentation<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-ensemble-presentation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/lem:ensemble-presentation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-ensemble-presentation.tex", target="_top"];
    "transmitter/lem:matched-pinching" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/lem:matched-pinching<BR/>Matched pinching of a block<BR/>certificate<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-matched-pinching.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/lem:matched-pinching" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-matched-pinching.tex", target="_top"];
    "transmitter/rem:boundary" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/rem:boundary<BR/>Scope of a verified certificate<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-boundary.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/rem:boundary" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-boundary.tex", target="_top"];
    "transmitter/rem:certificate-forms" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/rem:certificate-forms<BR/>Purity and exact declarability of the<BR/>certificate forms<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-certificate-forms.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/rem:certificate-forms" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-certificate-forms.tex", target="_top"];
    "transmitter/rem:da1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/rem:da1<BR/>The one-dimensional retained system<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-da1.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/rem:da1" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-da1.tex", target="_top"];
    "transmitter/rem:xreg" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/rem:xreg<BR/>Necessity and cost of the outcome-<BR/>register hypothesis<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-xreg.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/rem:xreg" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-xreg.tex", target="_top"];
    "transmitter/thm:certificate-sufficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">transmitter/thm:certificate-sufficiency<BR/>Checkability and sufficiency of the<BR/>source-replacement certificate<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-certificate-sufficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-transmitter/thm:certificate-sufficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-certificate-sufficiency.tex", target="_top"];
  }
  "transmitter/cor:noncanonical" -> "transmitter/def:source-spec";
  "transmitter/cor:noncanonical" -> "transmitter/def:srcert";
  "transmitter/cor:noncanonical" -> "transmitter/fact:sr";
  "transmitter/cor:noncanonical" -> "transmitter/thm:certificate-sufficiency";
  "transmitter/lem:matched-pinching" -> "transmitter/ass:src" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/lem:matched-pinching" -> "transmitter/def:source-spec";
  "transmitter/lem:matched-pinching" -> "transmitter/def:srcert";
  "transmitter/rem:boundary" -> "transmitter/def:source-segment";
  "transmitter/rem:boundary" -> "transmitter/def:srcert";
  "transmitter/rem:boundary" -> "transmitter/lem:matched-pinching";
  "transmitter/rem:boundary" -> "transmitter/thm:certificate-sufficiency";
  "transmitter/rem:certificate-forms" -> "transmitter/def:srcert";
  "transmitter/rem:da1" -> "transmitter/def:source-spec";
  "transmitter/rem:da1" -> "transmitter/def:srcert";
  "transmitter/rem:xreg" -> "transmitter/ass:seq" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/rem:xreg" -> "transmitter/thm:certificate-sufficiency";
  "transmitter/thm:certificate-sufficiency" -> "transmitter/ass:seq" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/thm:certificate-sufficiency" -> "transmitter/ass:src" [style=dashed, color="#a35f13", tooltip="assumes"];
  "transmitter/thm:certificate-sufficiency" -> "transmitter/def:source-spec";
  "transmitter/thm:certificate-sufficiency" -> "transmitter/def:srcert";
  "transmitter/thm:certificate-sufficiency" -> "transmitter/lem:ensemble-presentation";
}
