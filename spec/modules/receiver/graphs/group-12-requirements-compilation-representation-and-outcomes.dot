digraph claims {
  rankdir=LR;
  graph [label="12 Requirements: compilation, representation and outcomes\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/def:graph" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:graph<BR/>Declared element graph<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-graph.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:graph" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-graph.tex", target="_top"];
    "receiver/def:probe" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:probe<BR/>Probe declaration<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-probe.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:probe" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-probe.tex", target="_top"];
    "receiver/rem:unmonitored" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:unmonitored<BR/>Unmonitored output modes<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-unmonitored.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:unmonitored" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-unmonitored.tex", target="_top"];
    "receiver/req:declared-alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:declared-alphabet<BR/>Declared emitted alphabet and coarse-<BR/>graining<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-declared-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:declared-alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-declared-alphabet.tex", target="_top"];
    "receiver/req:declared-port-map" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:declared-port-map<BR/>Declared port map<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-declared-port-map.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:declared-port-map" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-declared-port-map.tex", target="_top"];
    "receiver/req:graph-refusal" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:graph-refusal<BR/>Refusal of a graph that is not well<BR/>formed<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-graph-refusal.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:graph-refusal" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-graph-refusal.tex", target="_top"];
    "receiver/req:one-mode-per-port" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:one-mode-per-port<BR/>One mode per port only where the rank<BR/>criterion holds<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-one-mode-per-port.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:one-mode-per-port" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-one-mode-per-port.tex", target="_top"];
    "receiver/req:probe-diagonal-admission" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:probe-diagonal-admission<BR/>Admission of Gaussian-tier probe<BR/>states only<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-probe-diagonal-admission.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:probe-diagonal-admission" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-probe-diagonal-admission.tex", target="_top"];
    "receiver/thm:compilation-well-defined" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:compilation-well-defined<BR/>Well-definedness of compilation<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-compilation-well-defined.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:compilation-well-defined" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-compilation-well-defined.tex", target="_top"];
    "receiver/thm:representation-independence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:representation-independence<BR/>Representation independence of the<BR/>click-pattern POVM<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-representation-independence.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:representation-independence" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-representation-independence.tex", target="_top"];
  }
  "receiver/req:declared-port-map" -> "receiver/rem:unmonitored";
  "receiver/req:graph-refusal" -> "receiver/def:graph";
  "receiver/req:graph-refusal" -> "receiver/thm:compilation-well-defined";
  "receiver/req:one-mode-per-port" -> "receiver/thm:representation-independence";
  "receiver/req:probe-diagonal-admission" -> "receiver/def:probe";
}
