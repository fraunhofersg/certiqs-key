digraph claims {
  rankdir=LR;
  graph [label="15 Requirements: the assumptions\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/req:decidable-assumptions" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:decidable-assumptions<BR/>Validation of the assumptions on the<BR/>declared data<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-decidable-assumptions.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:decidable-assumptions" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-decidable-assumptions.tex", target="_top"];
    "receiver/req:eig-ledger-row" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:eig-ledger-row<BR/>Invoking settings on the eigenvalue-<BR/>slack row of the ledger<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-eig-ledger-row.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:eig-ledger-row" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-eig-ledger-row.tex", target="_top"];
    "receiver/req:reserved-tolerance-field" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:reserved-tolerance-field<BR/>Refusal of a non-zero parameter<BR/>tolerance<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-reserved-tolerance-field.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:reserved-tolerance-field" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-reserved-tolerance-field.tex", target="_top"];
    "receiver/req:rigorous-weight" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/req:rigorous-weight<BR/>Rigorous evaluation of the multiclick<BR/>weight<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/req-rigorous-weight.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/req:rigorous-weight" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/req-rigorous-weight.tex", target="_top"];
  }
  "receiver/req:eig-ledger-row" -> "receiver/req:rigorous-weight";
}
