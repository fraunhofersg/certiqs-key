digraph claims {
  rankdir=LR;
  graph [label="3 Component graphs and compilation\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/ass:vac" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/ass:vac<BR/>Vacuum on undeclared input modes<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-vac.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/ass:vac" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-vac.tex", target="_top"];
    "receiver/cor:compiled-instrument" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/cor:compiled-instrument<BR/>Receiver instrument from a well-formed<BR/>graph declaration<BR/>accepted</TD></TR><TR><TD HREF="../claims/cor-compiled-instrument.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/cor:compiled-instrument" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/cor-compiled-instrument.tex", target="_top"];
    "receiver/def:catalogue" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:catalogue<BR/>Component catalogue<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-catalogue.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:catalogue" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-catalogue.tex", target="_top"];
    "receiver/def:compile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:compile<BR/>Compilation of a declared element<BR/>graph<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-compile.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:compile" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-compile.tex", target="_top"];
    "receiver/def:embed" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:embed<BR/>Local element and its embedding<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-embed.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:embed" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-embed.tex", target="_top"];
    "receiver/def:graph" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:graph<BR/>Declared element graph<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-graph.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:graph" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-graph.tex", target="_top"];
    "receiver/def:instrument" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:instrument<BR/>Receiver instrument<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-instrument.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:instrument" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-instrument.tex", target="_top"];
    "receiver/prop:mode-algebra" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/prop:mode-algebra<BR/>Algebra of embedded local elements<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/prop-mode-algebra.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/prop:mode-algebra" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/prop-mode-algebra.tex", target="_top"];
    "receiver/rem:acyc-efficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:acyc-efficiency<BR/>Where the element graph enters the<BR/>efficiency theorem<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-acyc-efficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:acyc-efficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-acyc-efficiency.tex", target="_top"];
    "receiver/rem:e3" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:e3<BR/>Order dependence without support<BR/>comparability<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-e3.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:e3" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-e3.tex", target="_top"];
    "receiver/rem:edgemeaning" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:edgemeaning<BR/>Meaning of an edge<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-edgemeaning.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:edgemeaning" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-edgemeaning.tex", target="_top"];
    "receiver/rem:noloops" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:noloops<BR/>Feedback paths outside the acyclic<BR/>scope<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-noloops.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:noloops" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-noloops.tex", target="_top"];
    "receiver/thm:compilation-well-defined" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:compilation-well-defined<BR/>Well-definedness of compilation<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-compilation-well-defined.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:compilation-well-defined" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-compilation-well-defined.tex", target="_top"];
  }
  "receiver/cor:compiled-instrument" -> "receiver/ass:vac" [style=dashed, color="#a35f13", tooltip="assumes"];
  "receiver/cor:compiled-instrument" -> "receiver/def:compile";
  "receiver/cor:compiled-instrument" -> "receiver/def:graph";
  "receiver/cor:compiled-instrument" -> "receiver/def:instrument";
  "receiver/cor:compiled-instrument" -> "receiver/thm:compilation-well-defined";
  "receiver/def:catalogue" -> "receiver/def:embed";
  "receiver/def:compile" -> "receiver/def:graph";
  "receiver/def:compile" -> "receiver/def:instrument";
  "receiver/def:graph" -> "receiver/def:catalogue";
  "receiver/rem:noloops" -> "receiver/def:graph";
  "receiver/thm:compilation-well-defined" -> "receiver/def:compile";
  "receiver/thm:compilation-well-defined" -> "receiver/def:graph";
  "receiver/thm:compilation-well-defined" -> "receiver/prop:mode-algebra";
}
