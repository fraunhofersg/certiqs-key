digraph claims {
  rankdir=LR;
  graph [label="1 Modes, Fock space and the mode algebra\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/def:embed" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:embed<BR/>Local element and its embedding<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-embed.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:embed" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-embed.tex", target="_top"];
    "receiver/def:fock" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:fock<BR/>Fock space and the second-quantization<BR/>functor<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-fock.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:fock" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-fock.tex", target="_top"];
    "receiver/def:modes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:modes<BR/>Declared mode space<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-modes.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:modes" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-modes.tex", target="_top"];
    "receiver/lem:fock-block-spectrum" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-block-spectrum<BR/>Spectrum of a lifted no-click operator<BR/>on a photon-number block<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-fock-block-spectrum.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-block-spectrum" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-fock-block-spectrum.tex", target="_top"];
    "receiver/lem:fock-functor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-functor<BR/>Functoriality of the Fock lift<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-fock-functor.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-functor" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-fock-functor.tex", target="_top"];
    "receiver/lem:fock-maps" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-maps<BR/>The lift of maps between mode spaces<BR/>and of direct sums<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-fock-maps.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-maps" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-fock-maps.tex", target="_top"];
    "receiver/lem:fock-monotone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-monotone<BR/>Order monotonicity of the Fock lift<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-fock-monotone.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-monotone" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-fock-monotone.tex", target="_top"];
    "receiver/prop:mode-algebra" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/prop:mode-algebra<BR/>Algebra of embedded local elements<BR/>accepted</TD></TR><TR><TD HREF="../claims/prop-mode-algebra.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/prop:mode-algebra" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/prop-mode-algebra.tex", target="_top"];
    "receiver/prop:normord" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/prop:normord<BR/>Normal-ordered form of a lifted no-<BR/>click operator<BR/>accepted</TD></TR><TR><TD HREF="../claims/prop-normord.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/prop:normord" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/prop-normord.tex", target="_top"];
    "receiver/rem:konig" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:konig<BR/>The single-mode normal-ordering<BR/>identity in the literature<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-konig.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:konig" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-konig.tex", target="_top"];
    "receiver/rem:migdal" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:migdal<BR/>Mode and particle descriptions in the<BR/>literature<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-migdal.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:migdal" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-migdal.tex", target="_top"];
    "receiver/rem:overlap" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:overlap<BR/>Disjoint mode supports as the<BR/>commutation hypothesis<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-overlap.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:overlap" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-overlap.tex", target="_top"];
    "receiver/rem:whyprojector" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:whyprojector<BR/>Derivations without normal ordering<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-whyprojector.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:whyprojector" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-whyprojector.tex", target="_top"];
  }
  "receiver/lem:fock-block-spectrum" -> "receiver/lem:fock-functor";
  "receiver/lem:fock-functor" -> "receiver/def:fock";
  "receiver/lem:fock-maps" -> "receiver/def:fock";
  "receiver/lem:fock-maps" -> "receiver/lem:fock-functor";
  "receiver/lem:fock-monotone" -> "receiver/lem:fock-functor";
  "receiver/prop:mode-algebra" -> "receiver/def:embed";
  "receiver/prop:mode-algebra" -> "receiver/def:modes";
  "receiver/prop:normord" -> "receiver/lem:fock-block-spectrum";
  "receiver/prop:normord" -> "receiver/lem:fock-functor";
  "receiver/rem:konig" -> "receiver/lem:fock-functor";
  "receiver/rem:konig" -> "receiver/prop:normord";
  "receiver/rem:migdal" -> "receiver/lem:fock-functor";
  "receiver/rem:whyprojector" -> "receiver/lem:fock-functor";
  "receiver/rem:whyprojector" -> "receiver/prop:normord";
}
