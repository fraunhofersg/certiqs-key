digraph claims {
  rankdir=LR;
  graph [label="6 The analytic high-photon bound\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/cor:unconditioned-family" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/cor:unconditioned-family<BR/>The unconditioned receiver is a<BR/>setting family<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/cor-unconditioned-family.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/cor:unconditioned-family" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/cor-unconditioned-family.tex", target="_top"];
    "receiver/def:bounddata" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:bounddata<BR/>Admissible bound data and the bound<BR/>function<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-bounddata.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:bounddata" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-bounddata.tex", target="_top"];
    "receiver/lem:collapse" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:collapse<BR/>Collapse of the tail infimum to the<BR/>first photon number<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-collapse.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:collapse" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-collapse.tex", target="_top"];
    "receiver/lem:fock-block-spectrum" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-block-spectrum<BR/>Spectrum of a lifted no-click operator<BR/>on a photon-number block<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-fock-block-spectrum.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-block-spectrum" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-fock-block-spectrum.tex", target="_top"];
    "receiver/lem:windowtail" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:windowtail<BR/>Window-and-tail bound on the tail<BR/>infimum<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-windowtail.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:windowtail" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-windowtail.tex", target="_top"];
    "receiver/rem:collapsesharp" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:collapsesharp<BR/>Sharpness of the collapse lemma<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-collapsesharp.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:collapsesharp" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-collapsesharp.tex", target="_top"];
    "receiver/rem:k-minus-1" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:k-minus-1<BR/>The coefficient K-1 of the all-dark<BR/>element<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-k-minus-1.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:k-minus-1" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-k-minus-1.tex", target="_top"];
    "receiver/rem:kamin" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:kamin<BR/>Relation to a published multiclick<BR/>weight bound<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-kamin.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:kamin" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-kamin.tex", target="_top"];
    "receiver/rem:n0" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:n0<BR/>The monotonicity step at zero photons<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-n0.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:n0" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-n0.tex", target="_top"];
    "receiver/thm:click-povm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:click-povm<BR/>Click-pattern POVM<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-click-povm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:click-povm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-click-povm.tex", target="_top"];
    "receiver/thm:multiclick-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:multiclick-bound<BR/>Lower bound on every multiclick block<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-multiclick-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:multiclick-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-multiclick-bound.tex", target="_top"];
  }
  "receiver/def:bounddata" -> "receiver/lem:fock-block-spectrum";
  "receiver/lem:collapse" -> "receiver/def:bounddata";
  "receiver/lem:windowtail" -> "receiver/def:bounddata";
  "receiver/lem:windowtail" -> "receiver/lem:collapse";
  "receiver/rem:collapsesharp" -> "receiver/cor:unconditioned-family";
  "receiver/rem:collapsesharp" -> "receiver/def:bounddata";
  "receiver/rem:collapsesharp" -> "receiver/lem:collapse";
  "receiver/rem:k-minus-1" -> "receiver/thm:click-povm";
  "receiver/rem:kamin" -> "receiver/thm:multiclick-bound";
  "receiver/rem:n0" -> "receiver/lem:collapse";
  "receiver/thm:multiclick-bound" -> "receiver/def:bounddata";
  "receiver/thm:multiclick-bound" -> "receiver/lem:fock-block-spectrum";
}
