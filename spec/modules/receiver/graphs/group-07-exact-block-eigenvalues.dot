digraph claims {
  rankdir=LR;
  graph [label="7 Exact block eigenvalues\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/def:exactbnd" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:exactbnd<BR/>The exact block bound function<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-exactbnd.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:exactbnd" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-exactbnd.tex", target="_top"];
    "receiver/def:fock" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:fock<BR/>Fock space and the second-quantization<BR/>functor<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-fock.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:fock" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-fock.tex", target="_top"];
    "receiver/lem:collapse" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:collapse<BR/>Collapse of the tail infimum to the<BR/>first photon number<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-collapse.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:collapse" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-collapse.tex", target="_top"];
    "receiver/lem:exactbasic" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:exactbasic<BR/>Range of the exact block bound<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-exactbasic.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:exactbasic" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-exactbasic.tex", target="_top"];
    "receiver/lem:exactwindow" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:exactwindow<BR/>Exact window with an analytic<BR/>remainder<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-exactwindow.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:exactwindow" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-exactwindow.tex", target="_top"];
    "receiver/lem:fock-block-spectrum" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-block-spectrum<BR/>Spectrum of a lifted no-click operator<BR/>on a photon-number block<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-fock-block-spectrum.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-block-spectrum" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-fock-block-spectrum.tex", target="_top"];
    "receiver/lem:fock-functor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-functor<BR/>Functoriality of the Fock lift<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-fock-functor.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-functor" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-fock-functor.tex", target="_top"];
    "receiver/lem:fock-monotone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-monotone<BR/>Order monotonicity of the Fock lift<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-fock-monotone.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-monotone" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-fock-monotone.tex", target="_top"];
    "receiver/lem:windowtail" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:windowtail<BR/>Window-and-tail bound on the tail<BR/>infimum<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-windowtail.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:windowtail" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-windowtail.tex", target="_top"];
    "receiver/rem:exactpositivity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:exactpositivity<BR/>Positivity of the multiclick element<BR/>as a separate hypothesis<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-exactpositivity.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:exactpositivity" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-exactpositivity.tex", target="_top"];
    "receiver/rem:exactscope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:exactscope<BR/>Scope of the exact-window lemma<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-exactscope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:exactscope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-exactscope.tex", target="_top"];
    "receiver/thm:click-povm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:click-povm<BR/>Click-pattern POVM<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-click-povm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:click-povm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-click-povm.tex", target="_top"];
    "receiver/thm:multiclick-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:multiclick-bound<BR/>Lower bound on every multiclick block<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-multiclick-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:multiclick-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-multiclick-bound.tex", target="_top"];
  }
  "receiver/def:exactbnd" -> "receiver/def:fock";
  "receiver/def:exactbnd" -> "receiver/lem:windowtail";
  "receiver/def:exactbnd" -> "receiver/thm:click-povm";
  "receiver/def:exactbnd" -> "receiver/thm:multiclick-bound";
  "receiver/lem:exactbasic" -> "receiver/def:exactbnd";
  "receiver/lem:exactbasic" -> "receiver/lem:fock-block-spectrum";
  "receiver/lem:exactbasic" -> "receiver/lem:fock-functor";
  "receiver/lem:exactbasic" -> "receiver/lem:fock-monotone";
  "receiver/lem:exactbasic" -> "receiver/thm:multiclick-bound";
  "receiver/lem:exactwindow" -> "receiver/lem:collapse";
  "receiver/lem:exactwindow" -> "receiver/lem:exactbasic";
  "receiver/lem:exactwindow" -> "receiver/lem:windowtail";
