    "receiver/detector-imperfections/prop:dark-slack-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/prop:dark-slack-bound<BR/>Multiclick bound under a dark-count<BR/>channel admitted with slack<BR/>implemented</TD></TR><TR><TD HREF="../detector-imperfections/claims/prop-dark-slack-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/prop:dark-slack-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../detector-imperfections/claims/prop-dark-slack-bound.tex", target="_top"];
    "receiver/detector-imperfections/rem:corrdark" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:corrdark<BR/>Correlated dark counts within a round<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-corrdark.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:corrdark" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-corrdark.tex", target="_top"];
    "receiver/detector-imperfections/rem:d2slack" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:d2slack<BR/>Cost of admitting a dark-count channel<BR/>with slack<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-d2slack.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:d2slack" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-d2slack.tex", target="_top"];
    "receiver/detector-imperfections/rem:rmintrap" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:rmintrap<BR/>The no-click column in the minimum<BR/>defining r_min<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-rmintrap.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:rmintrap" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-rmintrap.tex", target="_top"];
    "receiver/detector-imperfections/thm:dark-counts" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/thm:dark-counts<BR/>Dark counts on a photon-number block-<BR/>diagonal POVM<BR/>implemented</TD></TR><TR><TD HREF="../detector-imperfections/claims/thm-dark-counts.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/thm:dark-counts" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../detector-imperfections/claims/thm-dark-counts.tex", target="_top"];
  }
