digraph claims {
  rankdir=LR;
  graph [label="2 The receiver instrument and its physical model\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/ass:port" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/ass:port<BR/>Mode-insensitive port response<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-port.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/ass:port" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-port.tex", target="_top"];
    "receiver/ass:vac" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/ass:vac<BR/>Vacuum on undeclared input modes<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-vac.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/ass:vac" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-vac.tex", target="_top"];
    "receiver/def:fock" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:fock<BR/>Fock space and the second-quantization<BR/>functor<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-fock.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:fock" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-fock.tex", target="_top"];
    "receiver/def:gram" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:gram<BR/>Port Grams and the loss deficiency<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-gram.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:gram" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-gram.tex", target="_top"];
    "receiver/def:instrument" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:instrument<BR/>Receiver instrument<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-instrument.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:instrument" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-instrument.tex", target="_top"];
    "receiver/def:modes" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:modes<BR/>Declared mode space<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-modes.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:modes" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-modes.tex", target="_top"];
    "receiver/def:physmodel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:physmodel<BR/>The physical measurement model<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-physmodel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:physmodel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-physmodel.tex", target="_top"];
    "receiver/def:probe" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:probe<BR/>Probe declaration<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-probe.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:probe" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-probe.tex", target="_top"];
    "receiver/lem:dilation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:dilation<BR/>Unitary dilation of a contraction<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-dilation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:dilation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-dilation.tex", target="_top"];
    "receiver/lem:fock-functor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-functor<BR/>Functoriality of the Fock lift<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-fock-functor.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-functor" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/lem-fock-functor.tex", target="_top"];
    "receiver/lem:fock-maps" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:fock-maps<BR/>The lift of maps between mode spaces<BR/>and of direct sums<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-fock-maps.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:fock-maps" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-fock-maps.tex", target="_top"];
    "receiver/lem:vacelim" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:vacelim<BR/>Exactness of vacuum elimination<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-vacelim.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:vacelim" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-vacelim.tex", target="_top"];
    "receiver/rem:lossvsprobe" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:lossvsprobe<BR/>Loss ancillas and probe inputs<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-lossvsprobe.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:lossvsprobe" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-lossvsprobe.tex", target="_top"];
  }
  "receiver/def:gram" -> "receiver/def:instrument";
  "receiver/def:instrument" -> "receiver/def:fock";
  "receiver/def:instrument" -> "receiver/def:modes";
  "receiver/def:physmodel" -> "receiver/def:fock";
  "receiver/def:physmodel" -> "receiver/def:instrument";
  "receiver/def:physmodel" -> "receiver/lem:dilation";
  "receiver/def:physmodel" -> "receiver/lem:fock-functor";
  "receiver/def:physmodel" -> "receiver/lem:fock-maps";
  "receiver/def:probe" -> "receiver/def:fock";
  "receiver/def:probe" -> "receiver/def:instrument";
  "receiver/lem:vacelim" -> "receiver/ass:port" [style=dashed, color="#a35f13", tooltip="assumes"];
  "receiver/lem:vacelim" -> "receiver/ass:vac" [style=dashed, color="#a35f13", tooltip="assumes"];
  "receiver/lem:vacelim" -> "receiver/def:fock";
  "receiver/lem:vacelim" -> "receiver/def:physmodel";
  "receiver/lem:vacelim" -> "receiver/lem:fock-functor";
  "receiver/lem:vacelim" -> "receiver/lem:fock-maps";
  "receiver/rem:lossvsprobe" -> "receiver/def:probe";
  "receiver/rem:lossvsprobe" -> "receiver/lem:vacelim";
}
