digraph claims {
  rankdir=LR;
  graph [label="18 Detector imperfections: Detector efficiency\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_receiver" {
    label="receiver"; color="#cbd5df";
    "receiver/ass:trust" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/ass:trust<BR/>Trusted and exactly characterised<BR/>receiver<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-trust.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/ass:trust" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-trust.tex", target="_top"];
    "receiver/def:compile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:compile<BR/>Compilation of a declared element<BR/>graph<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-compile.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:compile" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-compile.tex", target="_top"];
    "receiver/def:residuals" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/def:residuals<BR/>The six residuals<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-residuals.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/def:residuals" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-residuals.tex", target="_top"];
    "receiver/lem:deficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/lem:deficiency<BR/>Decomposition of the loss deficiency<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-deficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/lem:deficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-deficiency.tex", target="_top"];
    "receiver/prop:mode-algebra" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/prop:mode-algebra<BR/>Algebra of embedded local elements<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/prop-mode-algebra.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/prop:mode-algebra" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/prop-mode-algebra.tex", target="_top"];
    "receiver/prop:normord" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/prop:normord<BR/>Normal-ordered form of a lifted no-<BR/>click operator<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/prop-normord.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/prop:normord" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/prop-normord.tex", target="_top"];
    "receiver/rem:rankone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/rem:rankone<BR/>Ports of rank greater than one<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-rankone.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/rem:rankone" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-rankone.tex", target="_top"];
    "receiver/thm:representation-independence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/thm:representation-independence<BR/>Representation independence of the<BR/>click-pattern POVM<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-representation-independence.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/thm:representation-independence" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-representation-independence.tex", target="_top"];
  }
  subgraph "cluster_receiver/detector-imperfections" {
    label="receiver/detector-imperfections"; color="#cbd5df";
    "receiver/detector-imperfections/rem:effrank" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:effrank<BR/>A port Gram whose rank drops under<BR/>within-port attenuation<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-effrank.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:effrank" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-effrank.tex", target="_top"];
    "receiver/detector-imperfections/rem:powervsclick" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:powervsclick<BR/>Power data and click data measure<BR/>different objects<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-powervsclick.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:powervsclick" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-powervsclick.tex", target="_top"];
    "receiver/detector-imperfections/rem:sperlingeta" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:sperlingeta<BR/>The single-mode efficiency<BR/>substitution in the photo-counting<BR/>formula<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-sperlingeta.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:sperlingeta" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-sperlingeta.tex", target="_top"];
    "receiver/detector-imperfections/rem:wrongcheck" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/rem:wrongcheck<BR/>Failure of the path-product loss audit<BR/>under interference<BR/>accepted</TD></TR><TR><TD HREF="../detector-imperfections/claims/rem-wrongcheck.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/rem:wrongcheck" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../detector-imperfections/claims/rem-wrongcheck.tex", target="_top"];
    "receiver/detector-imperfections/thm:efficiency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">receiver/detector-imperfections/thm:efficiency<BR/>Detector efficiency in the port Grams<BR/>implemented</TD></TR><TR><TD HREF="../detector-imperfections/claims/thm-efficiency.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-receiver/detector-imperfections/thm:efficiency" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../detector-imperfections/claims/thm-efficiency.tex", target="_top"];
  }
  "receiver/detector-imperfections/rem:effrank" -> "receiver/rem:rankone";
  "receiver/detector-imperfections/rem:effrank" -> "receiver/thm:representation-independence";
  "receiver/detector-imperfections/rem:powervsclick" -> "receiver/ass:trust" [style=dashed, color="#a35f13", tooltip="assumes"];
  "receiver/detector-imperfections/rem:powervsclick" -> "receiver/detector-imperfections/thm:efficiency";
  "receiver/detector-imperfections/rem:sperlingeta" -> "receiver/detector-imperfections/thm:efficiency";
  "receiver/detector-imperfections/rem:sperlingeta" -> "receiver/prop:normord";
  "receiver/detector-imperfections/rem:wrongcheck" -> "receiver/def:residuals";
  "receiver/detector-imperfections/rem:wrongcheck" -> "receiver/lem:deficiency";
  "receiver/detector-imperfections/thm:efficiency" -> "receiver/def:compile";
  "receiver/detector-imperfections/thm:efficiency" -> "receiver/lem:deficiency";
  "receiver/detector-imperfections/thm:efficiency" -> "receiver/prop:mode-algebra";
  "receiver/detector-imperfections/thm:efficiency" -> "receiver/thm:representation-independence";
}
