digraph claims {
  rankdir=LR;
  graph [label="27 Frank-Wolfe first-order bound: Requirements: the feasible side\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:exact-island" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:exact-island<BR/>The exact island<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/def-exact-island.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/def:exact-island" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../../foundations/claims/def-exact-island.tex", target="_top"];
    "foundations/lem:least-eigenvalue-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:least-eigenvalue-bound<BR/>Least-eigenvalue lower bound from an<BR/>approximate eigenbasis<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/lem-least-eigenvalue-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/lem:least-eigenvalue-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../foundations/claims/lem-least-eigenvalue-bound.tex", target="_top"];
    "foundations/req:exact-island" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/req:exact-island<BR/>Exact arithmetic on the island,<BR/>unbudgeted rounding elsewhere<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/req-exact-island.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/req:exact-island" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../../foundations/claims/req-exact-island.tex", target="_top"];
  }
  subgraph "cluster_meat-core" {
    label="meat-core"; color="#cbd5df";
    "meat-core/def:support-frame" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:support-frame<BR/>Support frame and declared isometry<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-support-frame.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:support-frame" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-support-frame.tex", target="_top"];
  }
  subgraph "cluster_meat-core/frank-wolfe" {
    label="meat-core/frank-wolfe"; color="#cbd5df";
    "meat-core/frank-wolfe/lem:feasible-side-dual" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/lem:feasible-side-dual<BR/>A lower bound on the feasible-side<BR/>minimum from any multipliers<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../frank-wolfe/claims/lem-feasible-side-dual.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/lem:feasible-side-dual" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../frank-wolfe/claims/lem-feasible-side-dual.tex", target="_top"];
    "meat-core/frank-wolfe/req:primal-pairing" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/req:primal-pairing<BR/>The primal pairing in the first-order<BR/>bracket<BR/>superseded</TD></TR><TR><TD HREF="../frank-wolfe/claims/req-primal-pairing.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/req:primal-pairing" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#e2e2e2", style="rounded,filled", URL="../frank-wolfe/claims/req-primal-pairing.tex", target="_top"];
    "meat-core/frank-wolfe/req:verified-feasible-side" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/req:verified-feasible-side<BR/>The verified feasible side of every<BR/>bracket<BR/>implemented</TD></TR><TR><TD HREF="../frank-wolfe/claims/req-verified-feasible-side.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/req:verified-feasible-side" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../frank-wolfe/claims/req-verified-feasible-side.tex", target="_top"];
    "meat-core/frank-wolfe/thm:firstorder" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/thm:firstorder<BR/>The estimate and the first-order lower<BR/>bound<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../frank-wolfe/claims/thm-firstorder.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/thm:firstorder" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../frank-wolfe/claims/thm-firstorder.tex", target="_top"];
  }
  "meat-core/frank-wolfe/req:primal-pairing" -> "meat-core/frank-wolfe/thm:firstorder";
  "meat-core/frank-wolfe/req:verified-feasible-side" -> "foundations/def:exact-island";
  "meat-core/frank-wolfe/req:verified-feasible-side" -> "foundations/lem:least-eigenvalue-bound";
  "meat-core/frank-wolfe/req:verified-feasible-side" -> "foundations/req:exact-island";
  "meat-core/frank-wolfe/req:verified-feasible-side" -> "meat-core/def:support-frame";
  "meat-core/frank-wolfe/req:verified-feasible-side" -> "meat-core/frank-wolfe/lem:feasible-side-dual";
  "meat-core/frank-wolfe/req:verified-feasible-side" -> "meat-core/frank-wolfe/thm:firstorder";
}
