digraph claims {
  rankdir=LR;
  graph [label="13 Assumptions\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:round-model" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:round-model<BR/>Round model, attack sequences and<BR/>attack sets<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/def-round-model.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/def:round-model" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../../foundations/claims/def-round-model.tex", target="_top"];
  }
  subgraph "cluster_meat-core" {
    label="meat-core"; color="#cbd5df";
    "meat-core/ass:auth" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:auth<BR/>Authentication of the classical<BR/>channel by a keyed scheme<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-auth.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:auth" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-auth.tex", target="_top"];
    "meat-core/ass:conform" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:conform<BR/>The implementation runs the analysed<BR/>post-processing<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-conform.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:conform" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-conform.tex", target="_top"];
    "meat-core/ass:eve-dim" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:eve-dim<BR/>The adversary&#x27;s registers are finite-<BR/>dimensional<BR/>superseded</TD></TR><TR><TD HREF="../claims/ass-eve-dim.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:eve-dim" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#e2e2e2", style="rounded,filled", URL="../claims/ass-eve-dim.tex", target="_top"];
    "meat-core/ass:fixed" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:fixed<BR/>Protocol parameters fixed before the<BR/>run<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-fixed.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:fixed" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-fixed.tex", target="_top"];
    "meat-core/ass:hash" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:hash<BR/>Ideal two-universal privacy<BR/>amplification<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-hash.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:hash" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-hash.tex", target="_top"];
    "meat-core/ass:keyreg" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:keyreg<BR/>Dedicated key register and one-way<BR/>reconciliation<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-keyreg.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:keyreg" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-keyreg.tex", target="_top"];
    "meat-core/ass:lab" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:lab<BR/>Each party&#x27;s laboratory is sealed<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-lab.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:lab" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-lab.tex", target="_top"];
    "meat-core/ass:seed" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:seed<BR/>Private, independent and fresh local<BR/>randomness<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-seed.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:seed" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-seed.tex", target="_top"];
    "meat-core/ass:separate-executions" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/ass:separate-executions<BR/>Executions that share no key and no<BR/>device state<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-separate-executions.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/ass:separate-executions" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-separate-executions.tex", target="_top"];
    "meat-core/def:authenticated-channel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:authenticated-channel<BR/>Authenticated classical channel and<BR/>authentication post-processing<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-authenticated-channel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:authenticated-channel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-authenticated-channel.tex", target="_top"];
    "meat-core/def:declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:declaration<BR/>The protocol declaration as the MEAT<BR/>core reads it<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-declaration.tex", target="_top"];
    "meat-core/def:execution-end" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:execution-end<BR/>The end of an execution<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-execution-end.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:execution-end" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-execution-end.tex", target="_top"];
    "meat-core/def:postprocessing-model" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:postprocessing-model<BR/>Fixed-length post-processing model<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-postprocessing-model.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:postprocessing-model" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-postprocessing-model.tex", target="_top"];
    "meat-core/def:roundmodel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:roundmodel<BR/>Round model and licensed attack sets<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-roundmodel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:roundmodel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-roundmodel.tex", target="_top"];
  }
  "meat-core/ass:auth" -> "meat-core/def:authenticated-channel";
  "meat-core/ass:conform" -> "meat-core/def:authenticated-channel";
  "meat-core/ass:conform" -> "meat-core/def:execution-end";
  "meat-core/ass:conform" -> "meat-core/def:postprocessing-model";
  "meat-core/ass:eve-dim" -> "foundations/def:round-model";
  "meat-core/ass:fixed" -> "meat-core/def:authenticated-channel";
  "meat-core/ass:fixed" -> "meat-core/def:postprocessing-model";
  "meat-core/ass:hash" -> "meat-core/def:postprocessing-model";
  "meat-core/ass:keyreg" -> "meat-core/def:declaration";
  "meat-core/ass:keyreg" -> "meat-core/def:postprocessing-model";
  "meat-core/ass:lab" -> "meat-core/def:authenticated-channel";
  "meat-core/ass:lab" -> "meat-core/def:declaration";
  "meat-core/ass:lab" -> "meat-core/def:postprocessing-model";
  "meat-core/ass:lab" -> "meat-core/def:roundmodel";
  "meat-core/ass:seed" -> "meat-core/def:postprocessing-model";
  "meat-core/ass:separate-executions" -> "meat-core/def:execution-end";
}
