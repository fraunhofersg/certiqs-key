digraph claims {
  rankdir=LR;
  graph [label="20 Frank-Wolfe first-order bound: The verified feasible side\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_meat-core" {
    label="meat-core"; color="#cbd5df";
    "meat-core/def:declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:declaration<BR/>The protocol declaration as the MEAT<BR/>core reads it<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-declaration.tex", target="_top"];
    "meat-core/def:feasible" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:feasible<BR/>Feasible set and computable objective<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-feasible.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:feasible" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-feasible.tex", target="_top"];
    "meat-core/def:joint-sectors" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:joint-sectors<BR/>Joint-sector deficits and the joint<BR/>key-active index set<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-joint-sectors.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:joint-sectors" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-joint-sectors.tex", target="_top"];
    "meat-core/def:untrusted-choi" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:untrusted-choi<BR/>The program in untrusted-source mode<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-untrusted-choi.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:untrusted-choi" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-untrusted-choi.tex", target="_top"];
    "meat-core/prop:frame-free-rows" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/prop:frame-free-rows<BR/>Frame-free constraint rows on a tight<BR/>frame<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/prop-frame-free-rows.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/prop:frame-free-rows" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/prop-frame-free-rows.tex", target="_top"];
    "meat-core/thm:choi" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/thm:choi<BR/>The Choi program<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-choi.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/thm:choi" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-choi.tex", target="_top"];
  }
  subgraph "cluster_meat-core/frank-wolfe" {
    label="meat-core/frank-wolfe"; color="#cbd5df";
    "meat-core/frank-wolfe/def:first-order-setting" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/def:first-order-setting<BR/>Ambient program, pairings, acceptance<BR/>support and linear minimisation<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../frank-wolfe/claims/def-first-order-setting.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/def:first-order-setting" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../frank-wolfe/claims/def-first-order-setting.tex", target="_top"];
    "meat-core/frank-wolfe/lem:feasible-side-dual" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/lem:feasible-side-dual<BR/>A lower bound on the feasible-side<BR/>minimum from any multipliers<BR/>implemented</TD></TR><TR><TD HREF="../frank-wolfe/claims/lem-feasible-side-dual.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/lem:feasible-side-dual" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../frank-wolfe/claims/lem-feasible-side-dual.tex", target="_top"];
  }
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/def:declaration";
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/def:feasible";
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/def:joint-sectors";
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/def:untrusted-choi";
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/frank-wolfe/def:first-order-setting";
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/prop:frame-free-rows";
  "meat-core/frank-wolfe/lem:feasible-side-dual" -> "meat-core/thm:choi";
}
