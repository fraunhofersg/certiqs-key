  "meat-core/prop:optol-nobound" -> "meat-core/thm:keylength";
  "meat-core/rem:declared-measurement" -> "foundations/def:evaluated-off-snap";
  "meat-core/rem:declared-measurement" -> "foundations/def:snap";
