    "meat-core/frank-wolfe/req:bacc-recorded" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/req:bacc-recorded<BR/>Record of the acceptance-side quantity<BR/>in the bracket<BR/>accepted</TD></TR><TR><TD HREF="../frank-wolfe/claims/req-bacc-recorded.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/req:bacc-recorded" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../frank-wolfe/claims/req-bacc-recorded.tex", target="_top"];
