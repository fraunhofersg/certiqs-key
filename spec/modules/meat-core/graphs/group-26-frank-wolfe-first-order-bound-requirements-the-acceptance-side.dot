    "meat-core/frank-wolfe/req:acceptance-geometries" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/req:acceptance-geometries<BR/>The admitted acceptance geometries<BR/>accepted</TD></TR><TR><TD HREF="../frank-wolfe/claims/req-acceptance-geometries.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/req:acceptance-geometries" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../frank-wolfe/claims/req-acceptance-geometries.tex", target="_top"];
