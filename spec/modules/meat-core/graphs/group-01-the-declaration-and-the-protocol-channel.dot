digraph claims {
  rankdir=LR;
  graph [label="1 The declaration and the protocol channel\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:declared-order" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:declared-order<BR/>Sums in a declared order and sums that<BR/>round nowhere<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/def-declared-order.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/def:declared-order" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../foundations/claims/def-declared-order.tex", target="_top"];
  }
  subgraph "cluster_meat-core" {
    label="meat-core"; color="#cbd5df";
    "meat-core/def:admissible-declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:admissible-declaration<BR/>Admissible declaration<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-admissible-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:admissible-declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-admissible-declaration.tex", target="_top"];
    "meat-core/def:branch" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:branch<BR/>Branch maps<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-branch.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:branch" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-branch.tex", target="_top"];
    "meat-core/def:declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:declaration<BR/>The protocol declaration as the MEAT<BR/>core reads it<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-declaration.tex", target="_top"];
    "meat-core/def:homog" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:homog<BR/>Licensed constraint list and its two<BR/>classes<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-homog.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:homog" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-homog.tex", target="_top"];
    "meat-core/def:maps" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/def:maps<BR/>Generated registers, isometries and<BR/>maps<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-maps.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/def:maps" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-maps.tex", target="_top"];
    "meat-core/lem:branch-maps" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/lem:branch-maps<BR/>Properties of the pass and fail branch<BR/>maps<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-branch-maps.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/lem:branch-maps" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-branch-maps.tex", target="_top"];
    "meat-core/lem:ensemble-form" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/lem:ensemble-form<BR/>The measurement an ensemble-form<BR/>declaration denotes<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-ensemble-form.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/lem:ensemble-form" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-ensemble-form.tex", target="_top"];
    "meat-core/rem:inert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/rem:inert<BR/>Inert register components of a branch<BR/>map<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-inert.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/rem:inert" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-inert.tex", target="_top"];
    "meat-core/thm:protocol-channel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/thm:protocol-channel<BR/>The declaration generates a protocol<BR/>channel<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-protocol-channel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/thm:protocol-channel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-protocol-channel.tex", target="_top"];
  }
  subgraph "cluster_protocol-compiler" {
    label="protocol-compiler"; color="#cbd5df";
    "protocol-compiler/def:declaration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">protocol-compiler/def:declaration<BR/>Protocol declaration<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../protocol-compiler/claims/def-declaration.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../protocol-compiler/contract.pdf#nameddest=claim-protocol-compiler/def:declaration" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../protocol-compiler/claims/def-declaration.tex", target="_top"];
  }
  "meat-core/def:admissible-declaration" -> "meat-core/def:declaration";
  "meat-core/def:admissible-declaration" -> "meat-core/def:homog";
  "meat-core/def:declaration" -> "foundations/def:declared-order";
  "meat-core/def:declaration" -> "protocol-compiler/def:declaration";
  "meat-core/lem:branch-maps" -> "meat-core/def:admissible-declaration";
  "meat-core/lem:branch-maps" -> "meat-core/def:branch";
  "meat-core/lem:branch-maps" -> "meat-core/def:declaration";
  "meat-core/lem:branch-maps" -> "meat-core/def:maps";
  "meat-core/lem:branch-maps" -> "meat-core/thm:protocol-channel";
  "meat-core/lem:ensemble-form" -> "meat-core/def:admissible-declaration";
  "meat-core/lem:ensemble-form" -> "meat-core/def:declaration";
  "meat-core/thm:protocol-channel" -> "meat-core/def:admissible-declaration";
  "meat-core/thm:protocol-channel" -> "meat-core/def:maps";
}
