    "meat-core/thm:gradient" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/thm:gradient<BR/>Gradient of the pinched trace power on<BR/>a face<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-gradient.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/thm:gradient" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-gradient.tex", target="_top"];
  }
  subgraph "cluster_meat-core/frank-wolfe" {
    label="meat-core/frank-wolfe"; color="#cbd5df";
    "meat-core/frank-wolfe/def:first-order-setting" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">meat-core/frank-wolfe/def:first-order-setting<BR/>Ambient program, pairings, acceptance<BR/>support and linear minimisation<BR/>implemented</TD></TR><TR><TD HREF="../frank-wolfe/claims/def-first-order-setting.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-meat-core/frank-wolfe/def:first-order-setting" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../frank-wolfe/claims/def-first-order-setting.tex", target="_top"];
