    "reductions/def:reduction-instance" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:reduction-instance<BR/>Reduction instance<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../reductions/claims/def-reduction-instance.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../reductions/contract.pdf#nameddest=claim-reductions/def:reduction-instance" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../reductions/claims/def-reduction-instance.tex", target="_top"];
    "reductions/lem:row-relaxation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:row-relaxation<BR/>A rounded constraint entry with its<BR/>constant relaxed<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../reductions/claims/lem-row-relaxation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../reductions/contract.pdf#nameddest=claim-reductions/lem:row-relaxation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../reductions/claims/lem-row-relaxation.tex", target="_top"];
