  "statistics/binomial-box/rem:guard-activation" -> "statistics/binomial-box/def:endpoint-rule";
  "statistics/binomial-box/rem:guard-activation" -> "statistics/binomial-box/def:interval";
  "statistics/binomial-box/rem:guard-activation" -> "statistics/binomial-box/lem:guard";
  "statistics/binomial-box/rem:guard-activation" -> "statistics/binomial-box/prop:rule-exact";
  "statistics/binomial-box/rem:guard-activation" -> "statistics/cor:tail-forms";
  "statistics/binomial-box/rem:guard-activation" -> "statistics/def:matched-alphabet";
  "statistics/binomial-box/rem:guard-activation" -> "statistics/lem:exact-strict-tails";
