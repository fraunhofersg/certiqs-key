digraph claims {
  rankdir=LR;
  graph [label="statistics: all local claims\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/ass:tsm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:tsm<BR/>Output-state test statistics<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../reductions/claims/ass-tsm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../reductions/contract.pdf#nameddest=claim-reductions/ass:tsm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../../reductions/claims/ass-tsm.tex", target="_top"];
  }
