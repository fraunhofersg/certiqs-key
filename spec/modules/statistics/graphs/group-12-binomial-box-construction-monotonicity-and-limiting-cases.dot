digraph claims {
  rankdir=LR;
  graph [label="12 Binomial box construction: Monotonicity and limiting cases\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
