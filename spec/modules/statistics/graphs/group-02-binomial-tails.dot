digraph claims {
  rankdir=LR;
  graph [label="2 Binomial tails\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_statistics" {
    label="statistics"; color="#cbd5df";
    "statistics/cor:tail-forms" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/cor:tail-forms<BR/>The two strict binomial tails<BR/>implemented</TD></TR><TR><TD HREF="../claims/cor-tail-forms.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/cor:tail-forms" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/cor-tail-forms.tex", target="_top"];
    "statistics/lem:exact-strict-tails" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/lem:exact-strict-tails<BR/>Exact strict tails at a rational<BR/>success probability<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-exact-strict-tails.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/lem:exact-strict-tails" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-exact-strict-tails.tex", target="_top"];
    "statistics/thm:binomial-tails" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/thm:binomial-tails<BR/>Binomial tails in closed form<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-binomial-tails.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/thm:binomial-tails" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-binomial-tails.tex", target="_top"];
  }
  "statistics/cor:tail-forms" -> "statistics/thm:binomial-tails";
  "statistics/lem:exact-strict-tails" -> "statistics/cor:tail-forms";
  "statistics/lem:exact-strict-tails" -> "statistics/thm:binomial-tails";
}
