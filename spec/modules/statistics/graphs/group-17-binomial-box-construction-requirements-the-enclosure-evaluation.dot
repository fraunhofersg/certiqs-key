digraph claims {
  rankdir=LR;
  graph [label="17 Binomial box construction: Requirements: the enclosure evaluation\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
