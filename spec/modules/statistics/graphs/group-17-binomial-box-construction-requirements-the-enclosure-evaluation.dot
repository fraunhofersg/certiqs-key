    "statistics/binomial-box/lem:tail-majorant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/lem:tail-majorant<BR/>The binomial tail from a window and a<BR/>geometric majorant<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/lem-tail-majorant.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/lem:tail-majorant" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/lem-tail-majorant.tex", target="_top"];
