    "statistics/binomial-box/def:endpoint-rule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/def:endpoint-rule<BR/>Admissible inputs, endpoint rules and<BR/>guarded endpoints<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/def-endpoint-rule.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/def:endpoint-rule" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/def-endpoint-rule.tex", target="_top"];
    "statistics/binomial-box/def:interval" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/def:interval<BR/>The exact binomial quantile rule<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/def-interval.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/def:interval" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/def-interval.tex", target="_top"];
    "statistics/binomial-box/lem:guard" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/lem:guard<BR/>The honest-containment guard for every<BR/>rule<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/lem-guard.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/lem:guard" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/lem-guard.tex", target="_top"];
    "statistics/binomial-box/rem:selector" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/rem:selector<BR/>The role of the constrained outcome<BR/>set<BR/>accepted</TD></TR><TR><TD HREF="../binomial-box/claims/rem-selector.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/rem:selector" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../binomial-box/claims/rem-selector.tex", target="_top"];
    "statistics/binomial-box/thm:box-construction" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/thm:box-construction<BR/>Properties of the constructed box<BR/>implemented</TD></TR><TR><TD HREF="../binomial-box/claims/thm-box-construction.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/thm:box-construction" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../binomial-box/claims/thm-box-construction.tex", target="_top"];
  }
  "statistics/binomial-box/def:construction" -> "statistics/binomial-box/def:endpoint-rule";
  "statistics/binomial-box/def:construction" -> "statistics/binomial-box/def:interval";
  "statistics/binomial-box/def:construction" -> "statistics/def:envelope";
  "statistics/binomial-box/def:construction" -> "statistics/def:taxonomy";
  "statistics/binomial-box/rem:selector" -> "statistics/binomial-box/def:construction";
  "statistics/binomial-box/thm:box-construction" -> "statistics/ass:alphabet" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/binomial-box/thm:box-construction" -> "statistics/binomial-box/def:construction";
  "statistics/binomial-box/thm:box-construction" -> "statistics/binomial-box/def:endpoint-rule";
  "statistics/binomial-box/thm:box-construction" -> "statistics/binomial-box/lem:guard";
  "statistics/binomial-box/thm:box-construction" -> "statistics/def:conservative-evaluation";
  "statistics/binomial-box/thm:box-construction" -> "statistics/def:envelope";
  "statistics/binomial-box/thm:box-construction" -> "statistics/def:taxonomy";
  "statistics/binomial-box/thm:box-construction" -> "statistics/thm:geometry-validation";
}
