digraph claims {
  rankdir=LR;
  graph [label="18 Singleton acceptance set: Completeness of a singleton acceptance set\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_statistics" {
    label="statistics"; color="#cbd5df";
    "statistics/ass:alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:alphabet<BR/>An acceptance value recorded in every<BR/>round<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-alphabet.tex", target="_top"];
    "statistics/ass:hon" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:hon<BR/>Honest i.i.d. rounds<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-hon.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:hon" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/ass-hon.tex", target="_top"];
    "statistics/def:envelope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:envelope<BR/>Honest envelope and its envelope set<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-envelope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:envelope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-envelope.tex", target="_top"];
    "statistics/def:freq" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:freq<BR/>Frequency vector and counts<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-freq.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:freq" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-freq.tex", target="_top"];
    "statistics/def:matched-alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:matched-alphabet<BR/>Alphabet and round count matched to<BR/>the consuming declaration<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-matched-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:matched-alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-matched-alphabet.tex", target="_top"];
  }
  subgraph "cluster_statistics/binomial-box" {
    label="statistics/binomial-box"; color="#cbd5df";
    "statistics/binomial-box/thm:completeness-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/thm:completeness-bound<BR/>The completeness bound<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/thm-completeness-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/thm:completeness-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/thm-completeness-bound.tex", target="_top"];
    "statistics/binomial-box/thm:monotonicity-limits" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/thm:monotonicity-limits<BR/>Monotonicity in the budget and<BR/>limiting cases<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/thm-monotonicity-limits.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/thm:monotonicity-limits" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../binomial-box/claims/thm-monotonicity-limits.tex", target="_top"];
  }
  subgraph "cluster_statistics/singleton" {
    label="statistics/singleton"; color="#cbd5df";
    "statistics/singleton/rem:singleton-honest" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/singleton/rem:singleton-honest<BR/>Certifiability and completeness of the<BR/>singleton<BR/>accepted</TD></TR><TR><TD HREF="../singleton/claims/rem-singleton-honest.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/singleton/rem:singleton-honest" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../singleton/claims/rem-singleton-honest.tex", target="_top"];
    "statistics/singleton/thm:singleton-completeness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/singleton/thm:singleton-completeness<BR/>Completeness of a singleton acceptance<BR/>set<BR/>implemented</TD></TR><TR><TD HREF="../singleton/claims/thm-singleton-completeness.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/singleton/thm:singleton-completeness" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../singleton/claims/thm-singleton-completeness.tex", target="_top"];
  }
  "statistics/singleton/rem:singleton-honest" -> "statistics/binomial-box/thm:completeness-bound";
  "statistics/singleton/rem:singleton-honest" -> "statistics/binomial-box/thm:monotonicity-limits";
  "statistics/singleton/rem:singleton-honest" -> "statistics/def:envelope";
  "statistics/singleton/rem:singleton-honest" -> "statistics/singleton/thm:singleton-completeness";
  "statistics/singleton/thm:singleton-completeness" -> "statistics/ass:alphabet" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/singleton/thm:singleton-completeness" -> "statistics/ass:hon" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/singleton/thm:singleton-completeness" -> "statistics/def:freq";
  "statistics/singleton/thm:singleton-completeness" -> "statistics/def:matched-alphabet";
}
