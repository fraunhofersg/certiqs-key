digraph claims {
  rankdir=LR;
  graph [label="3 The exact box oracle\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_statistics" {
    label="statistics"; color="#cbd5df";
    "statistics/ass:alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:alphabet<BR/>An acceptance value recorded in every<BR/>round<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-alphabet.tex", target="_top"];
    "statistics/def:matched-alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:matched-alphabet<BR/>Alphabet and round count matched to<BR/>the consuming declaration<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-matched-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:matched-alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-matched-alphabet.tex", target="_top"];
    "statistics/def:taxonomy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:taxonomy<BR/>Admissible geometries and the<BR/>canonical box form<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-taxonomy.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:taxonomy" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-taxonomy.tex", target="_top"];
    "statistics/rem:box-oracle-consumer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/rem:box-oracle-consumer<BR/>The closed-form box minimum for the<BR/>consuming engine<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-box-oracle-consumer.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/rem:box-oracle-consumer" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-box-oracle-consumer.tex", target="_top"];
    "statistics/thm:box-oracle" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/thm:box-oracle<BR/>Acceptance support and the exact box<BR/>oracle<BR/>implemented</TD></TR><TR><TD HREF="../claims/thm-box-oracle.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/thm:box-oracle" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/thm-box-oracle.tex", target="_top"];
    "statistics/thm:geometry-validation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/thm:geometry-validation<BR/>Validity of the admissible geometries<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-geometry-validation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/thm:geometry-validation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-geometry-validation.tex", target="_top"];
  }
  "statistics/rem:box-oracle-consumer" -> "statistics/thm:box-oracle";
  "statistics/thm:box-oracle" -> "statistics/ass:alphabet" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/thm:box-oracle" -> "statistics/def:matched-alphabet";
  "statistics/thm:box-oracle" -> "statistics/def:taxonomy";
  "statistics/thm:box-oracle" -> "statistics/thm:geometry-validation";
}
