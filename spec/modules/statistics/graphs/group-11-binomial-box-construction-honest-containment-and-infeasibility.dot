digraph claims {
  rankdir=LR;
  graph [label="11 Binomial box construction: Honest containment and infeasibility\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_statistics" {
    label="statistics"; color="#cbd5df";
    "statistics/ass:alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:alphabet<BR/>An acceptance value recorded in every<BR/>round<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-alphabet.tex", target="_top"];
    "statistics/ass:reach" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:reach<BR/>An honest law produced by a feasible<BR/>state<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-reach.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:reach" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-reach.tex", target="_top"];
    "statistics/def:conservative-evaluation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:conservative-evaluation<BR/>Exact data and conservative evaluation<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-conservative-evaluation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:conservative-evaluation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-conservative-evaluation.tex", target="_top"];
    "statistics/def:envelope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:envelope<BR/>Honest envelope and its envelope set<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-envelope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:envelope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-envelope.tex", target="_top"];
    "statistics/def:matched-alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:matched-alphabet<BR/>Alphabet and round count matched to<BR/>the consuming declaration<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-matched-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:matched-alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-matched-alphabet.tex", target="_top"];
    "statistics/thm:geometry-validation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/thm:geometry-validation<BR/>Validity of the admissible geometries<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-geometry-validation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/thm:geometry-validation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-geometry-validation.tex", target="_top"];
  }
  subgraph "cluster_statistics/binomial-box" {
    label="statistics/binomial-box"; color="#cbd5df";
    "statistics/binomial-box/def:endpoint-rule" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/def:endpoint-rule<BR/>Admissible inputs, endpoint rules and<BR/>guarded endpoints<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/def-endpoint-rule.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/def:endpoint-rule" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/def-endpoint-rule.tex", target="_top"];
    "statistics/binomial-box/rem:hlow-consequence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/rem:hlow-consequence<BR/>Scope of the statements on<BR/>infeasibility and minimal divergence<BR/>accepted</TD></TR><TR><TD HREF="../binomial-box/claims/rem-hlow-consequence.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/rem:hlow-consequence" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../binomial-box/claims/rem-hlow-consequence.tex", target="_top"];
    "statistics/binomial-box/thm:box-construction" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/thm:box-construction<BR/>Properties of the constructed box<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../binomial-box/claims/thm-box-construction.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/thm:box-construction" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../binomial-box/claims/thm-box-construction.tex", target="_top"];
    "statistics/binomial-box/thm:honest-containment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/binomial-box/thm:honest-containment<BR/>Honest containment and infeasibility<BR/>implemented</TD></TR><TR><TD HREF="../binomial-box/claims/thm-honest-containment.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/binomial-box/thm:honest-containment" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../binomial-box/claims/thm-honest-containment.tex", target="_top"];
  }
  "statistics/binomial-box/rem:hlow-consequence" -> "statistics/ass:reach" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/binomial-box/rem:hlow-consequence" -> "statistics/binomial-box/thm:honest-containment";
  "statistics/binomial-box/thm:honest-containment" -> "statistics/ass:alphabet" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/binomial-box/thm:honest-containment" -> "statistics/ass:reach" [style=dashed, color="#a35f13", tooltip="assumes"];
  "statistics/binomial-box/thm:honest-containment" -> "statistics/binomial-box/def:endpoint-rule";
  "statistics/binomial-box/thm:honest-containment" -> "statistics/binomial-box/thm:box-construction";
  "statistics/binomial-box/thm:honest-containment" -> "statistics/def:conservative-evaluation";
  "statistics/binomial-box/thm:honest-containment" -> "statistics/def:envelope";
  "statistics/binomial-box/thm:honest-containment" -> "statistics/def:matched-alphabet";
  "statistics/binomial-box/thm:honest-containment" -> "statistics/thm:geometry-validation";
}
