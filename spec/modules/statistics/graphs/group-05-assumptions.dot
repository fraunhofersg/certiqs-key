digraph claims {
  rankdir=LR;
  graph [label="5 Assumptions\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_statistics" {
    label="statistics"; color="#cbd5df";
    "statistics/ass:alphabet" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:alphabet<BR/>An acceptance value recorded in every<BR/>round<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-alphabet.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:alphabet" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-alphabet.tex", target="_top"];
    "statistics/ass:hon" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:hon<BR/>Honest i.i.d. rounds<BR/>implemented</TD></TR><TR><TD HREF="../claims/ass-hon.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:hon" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/ass-hon.tex", target="_top"];
    "statistics/ass:hon-env" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:hon-env<BR/>Honest rounds inside a declared<BR/>envelope<BR/>implemented</TD></TR><TR><TD HREF="../claims/ass-hon-env.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:hon-env" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/ass-hon-env.tex", target="_top"];
    "statistics/ass:reach" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/ass:reach<BR/>An honest law produced by a feasible<BR/>state<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-reach.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/ass:reach" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-reach.tex", target="_top"];
    "statistics/def:envelope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">statistics/def:envelope<BR/>Honest envelope and its envelope set<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-envelope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-statistics/def:envelope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-envelope.tex", target="_top"];
  }
  "statistics/ass:hon-env" -> "statistics/def:envelope";
  "statistics/ass:reach" -> "statistics/def:envelope";
}
