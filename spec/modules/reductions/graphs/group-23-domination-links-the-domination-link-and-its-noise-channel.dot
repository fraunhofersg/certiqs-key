    "reductions/domination/rem:rotated-projective" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/domination/rem:rotated-projective<BR/>Rotated projective elements and the<BR/>noise floor<BR/>accepted</TD></TR><TR><TD HREF="../domination/claims/rem-rotated-projective.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/domination/rem:rotated-projective" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../domination/claims/rem-rotated-projective.tex", target="_top"];
