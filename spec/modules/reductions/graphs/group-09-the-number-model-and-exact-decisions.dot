digraph claims {
  rankdir=LR;
  graph [label="9 The number model and exact decisions\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:binary64" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:binary64<BR/>Binary64 numbers, declared values and<BR/>dyadic lattices<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/def-binary64.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/def:binary64" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../foundations/claims/def-binary64.tex", target="_top"];
    "foundations/def:exact-admissibility" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:exact-admissibility<BR/>Exact admissibility of a declared<BR/>operator family<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/def-exact-admissibility.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/def:exact-admissibility" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../../foundations/claims/def-exact-admissibility.tex", target="_top"];
    "foundations/lem:binary64-lattice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:binary64-lattice<BR/>Binary64 numbers on dyadic lattices<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/lem-binary64-lattice.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/lem:binary64-lattice" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../../foundations/claims/lem-binary64-lattice.tex", target="_top"];
  }
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/def:exactadm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:exactadm<BR/>The number model, the declared lattice<BR/>and exact admissibility<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-exactadm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:exactadm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-exactadm.tex", target="_top"];
    "reductions/def:substrate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:substrate<BR/>The arithmetic substrate<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-substrate.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:substrate" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-substrate.tex", target="_top"];
    "reductions/lem:exactpsd" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:exactpsd<BR/>Exact decision of positivity and of an<BR/>operator-norm bound<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-exactpsd.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:exactpsd" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-exactpsd.tex", target="_top"];
    "reductions/lem:latsum" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:latsum<BR/>Partial sums on the declared lattice<BR/>are exact<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-latsum.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:latsum" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-latsum.tex", target="_top"];
    "reductions/rem:psdalgorithm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:psdalgorithm<BR/>Algorithms that decide the positivity<BR/>test<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-psdalgorithm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:psdalgorithm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-psdalgorithm.tex", target="_top"];
  }
  "reductions/def:exactadm" -> "foundations/def:binary64";
  "reductions/def:exactadm" -> "foundations/def:exact-admissibility";
  "reductions/def:exactadm" -> "foundations/lem:binary64-lattice";
  "reductions/def:substrate" -> "reductions/def:exactadm";
  "reductions/lem:exactpsd" -> "reductions/def:substrate";
  "reductions/lem:latsum" -> "reductions/def:exactadm";
  "reductions/rem:psdalgorithm" -> "reductions/lem:exactpsd";
}
