  "reductions/req:reference-companion" -> "foundations/lem:recentred-enclosure";
  "reductions/req:reference-companion" -> "foundations/req:snap-reference";
  "reductions/req:reference-companion" -> "reductions/cor:companion-factor-enclosure";
  "reductions/req:reference-companion" -> "reductions/cor:entries";
