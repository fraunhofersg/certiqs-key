    "reductions/req:class-marginal-entry" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:class-marginal-entry<BR/>The class-marginal entry only where<BR/>the instance discharges it<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-class-marginal-entry.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:class-marginal-entry" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-class-marginal-entry.tex", target="_top"];
    "reductions/req:class-marginal-operator-form" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:class-marginal-operator-form<BR/>Refusal of the operator form of the<BR/>class-marginal identity<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-class-marginal-operator-form.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:class-marginal-operator-form" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-class-marginal-operator-form.tex", target="_top"];
    "reductions/req:constraint-list-by-request" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:constraint-list-by-request<BR/>The constraint list and the licence<BR/>decided by the request<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-constraint-list-by-request.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:constraint-list-by-request" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-constraint-list-by-request.tex", target="_top"];
    "reductions/req:licensed-entry-lattice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:licensed-entry-lattice<BR/>Lattice condition on the entries of<BR/>emitted constraint operators<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-licensed-entry-lattice.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:licensed-entry-lattice" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-licensed-entry-lattice.tex", target="_top"];
    "reductions/req:party-local-tag" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:party-local-tag<BR/>The party-local tag and its scope<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-party-local-tag.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:party-local-tag" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-party-local-tag.tex", target="_top"];
    "reductions/req:transported-set-certificates" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:transported-set-certificates<BR/>Certificates carried with the<BR/>transported set<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-transported-set-certificates.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:transported-set-certificates" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-transported-set-certificates.tex", target="_top"];
    "reductions/req:uncertified-operator-refused" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:uncertified-operator-refused<BR/>Refusal of a requested operator<BR/>without a decided certificate<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-uncertified-operator-refused.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:uncertified-operator-refused" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-uncertified-operator-refused.tex", target="_top"];
    "reductions/thm:emitted-product" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/thm:emitted-product<BR/>The emission of several measuring<BR/>parties<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-emitted-product.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/thm:emitted-product" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-emitted-product.tex", target="_top"];
    "reductions/thm:licence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/thm:licence<BR/>The attack-set licence<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-licence.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/thm:licence" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/thm-licence.tex", target="_top"];
