  "reductions/req:class-marginal-entry" -> "reductions/rem:unsound";
  "reductions/req:class-marginal-operator-form" -> "reductions/rem:unsound";
  "reductions/req:constraint-list-by-request" -> "reductions/cor:entries";
  "reductions/req:constraint-list-by-request" -> "reductions/thm:licence";
  "reductions/req:licensed-entry-lattice" -> "reductions/def:reduction-instance";
  "reductions/req:party-local-tag" -> "reductions/rem:entry-tags";
  "reductions/req:party-local-tag" -> "reductions/thm:emitted-product";
  "reductions/req:transported-set-certificates" -> "reductions/cor:entries";
  "reductions/req:transported-set-certificates" -> "reductions/cor:pullback";
  "reductions/req:uncertified-operator-refused" -> "reductions/cor:entries";
}
