digraph claims {
  rankdir=LR;
  graph [label="14 Requirements: channel witnesses, post-processing and relations\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/cor:blockdiag" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:blockdiag<BR/>Restriction to block-diagonal squashed<BR/>states<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/cor-blockdiag.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:blockdiag" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/cor-blockdiag.tex", target="_top"];
    "reductions/cor:flagsenough" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:flagsenough<BR/>Arbitrary unpopulated block in a flag-<BR/>extended target<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/cor-flagsenough.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:flagsenough" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/cor-flagsenough.tex", target="_top"];
    "reductions/lem:obstructions" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:obstructions<BR/>Necessary conditions for a squashing<BR/>relation<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-obstructions.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:obstructions" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-obstructions.tex", target="_top"];
    "reductions/prop:common" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/prop:common<BR/>Common and dominating targets<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/prop-common.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/prop:common" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/prop-common.tex", target="_top"];
    "reductions/rem:channel-choice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:channel-choice<BR/>Soundness relative to the channel,<BR/>fixed by the carried tuple<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-channel-choice.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:channel-choice" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-channel-choice.tex", target="_top"];
    "reductions/rem:intertwining" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:intertwining<BR/>Classical maps before a squasher, and<BR/>relabelling after one<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-intertwining.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:intertwining" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-intertwining.tex", target="_top"];
    "reductions/rem:notchannel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:notchannel<BR/>Reductions that are not squashings<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-notchannel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:notchannel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-notchannel.tex", target="_top"];
    "reductions/rem:obstructiondecide" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:obstructiondecide<BR/>Exact decision of the necessary<BR/>conditions<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-obstructiondecide.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:obstructiondecide" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-obstructiondecide.tex", target="_top"];
    "reductions/rem:variants" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:variants<BR/>Variants of the factorization<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-variants.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:variants" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-variants.tex", target="_top"];
    "reductions/rem:why-exact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:why-exact<BR/>Exactness of the reductions and<BR/>generality of the transfer<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-why-exact.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:why-exact" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-why-exact.tex", target="_top"];
    "reductions/req:carried-tuple-emitted" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:carried-tuple-emitted<BR/>Emission of the carried tuple, and<BR/>constraints built from it<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-carried-tuple-emitted.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:carried-tuple-emitted" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-carried-tuple-emitted.tex", target="_top"];
    "reductions/req:channel-witness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:channel-witness<BR/>A channel witness for every emitted<BR/>link<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-channel-witness.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:channel-witness" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-channel-witness.tex", target="_top"];
    "reductions/req:declared-relation-check" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:declared-relation-check<BR/>Exact check of a declared relation<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-declared-relation-check.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:declared-relation-check" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-declared-relation-check.tex", target="_top"];
    "reductions/req:no-approximate-relations" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:no-approximate-relations<BR/>Refusal of approximate squashing<BR/>relations<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-no-approximate-relations.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:no-approximate-relations" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-no-approximate-relations.tex", target="_top"];
    "reductions/req:pinched-channel-witness" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:pinched-channel-witness<BR/>The pinched squashing channel as the<BR/>emitted witness<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-pinched-channel-witness.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:pinched-channel-witness" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-pinched-channel-witness.tex", target="_top"];
    "reductions/req:post-processing-order" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:post-processing-order<BR/>Noise and coarse-graining before the<BR/>first squashing link<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-post-processing-order.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:post-processing-order" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-post-processing-order.tex", target="_top"];
    "reductions/req:reserved-link-kinds" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:reserved-link-kinds<BR/>Refusal of the reserved receiver-stage<BR/>link kind<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-reserved-link-kinds.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:reserved-link-kinds" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-reserved-link-kinds.tex", target="_top"];
    "reductions/req:round-homogeneous-emission" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:round-homogeneous-emission<BR/>Emission of the round-homogeneous case<BR/>only<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-round-homogeneous-emission.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:round-homogeneous-emission" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-round-homogeneous-emission.tex", target="_top"];
    "reductions/req:unpadded-branch-blocks" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:unpadded-branch-blocks<BR/>Branch blocks emitted as supplied<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-unpadded-branch-blocks.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:unpadded-branch-blocks" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-unpadded-branch-blocks.tex", target="_top"];
  }
  "reductions/req:carried-tuple-emitted" -> "reductions/rem:channel-choice";
  "reductions/req:channel-witness" -> "reductions/rem:notchannel";
  "reductions/req:declared-relation-check" -> "reductions/lem:obstructions";
  "reductions/req:declared-relation-check" -> "reductions/rem:obstructiondecide";
  "reductions/req:no-approximate-relations" -> "reductions/rem:why-exact";
  "reductions/req:pinched-channel-witness" -> "reductions/cor:blockdiag";
  "reductions/req:pinched-channel-witness" -> "reductions/rem:channel-choice";
  "reductions/req:post-processing-order" -> "reductions/rem:intertwining";
  "reductions/req:reserved-link-kinds" -> "reductions/prop:common";
  "reductions/req:round-homogeneous-emission" -> "reductions/rem:variants";
  "reductions/req:unpadded-branch-blocks" -> "reductions/cor:flagsenough";
}
