digraph claims {
  rankdir=LR;
  graph [label="4 Operations on squashing relations\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/ass:tsm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:tsm<BR/>Output-state test statistics<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/ass-tsm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:tsm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/ass-tsm.tex", target="_top"];
    "reductions/cor:blockdiag" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:blockdiag<BR/>Restriction to block-diagonal squashed<BR/>states<BR/>accepted</TD></TR><TR><TD HREF="../claims/cor-blockdiag.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:blockdiag" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/cor-blockdiag.tex", target="_top"];
    "reductions/cor:monotone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:monotone<BR/>Monotonicity of the worst-case<BR/>criterion along the pre-order<BR/>accepted</TD></TR><TR><TD HREF="../claims/cor-monotone.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:monotone" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/cor-monotone.tex", target="_top"];
    "reductions/cor:sound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:sound<BR/>Imposing and intersecting sound<BR/>constraints<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/cor-sound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:sound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/cor-sound.tex", target="_top"];
    "reductions/def:exactadm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:exactadm<BR/>The number model, the declared lattice<BR/>and exact admissibility<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exactadm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:exactadm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-exactadm.tex", target="_top"];
    "reductions/def:joint-family" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:joint-family<BR/>Joint alphabet, classes and the joint<BR/>family of a private setting<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-joint-family.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:joint-family" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-joint-family.tex", target="_top"];
    "reductions/def:sound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:sound<BR/>Reachable states and sound constraints<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-sound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:sound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-sound.tex", target="_top"];
    "reductions/def:squashing" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:squashing<BR/>Squashing relation<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-squashing.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:squashing" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-squashing.tex", target="_top"];
    "reductions/lem:linear" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:linear<BR/>Linearity: post-processing, private<BR/>settings and mixtures<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-linear.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:linear" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-linear.tex", target="_top"];
    "reductions/lem:obstructions" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:obstructions<BR/>Necessary conditions for a squashing<BR/>relation<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-obstructions.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:obstructions" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-obstructions.tex", target="_top"];
    "reductions/lem:sep" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:sep<BR/>Separation and tensor adjoints in the<BR/>infinite-dimensional case<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/lem-sep.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:sep" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/lem-sep.tex", target="_top"];
    "reductions/prop:pinching" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/prop:pinching<BR/>Sector pinching as a squashing<BR/>accepted</TD></TR><TR><TD HREF="../claims/prop-pinching.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/prop:pinching" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/prop-pinching.tex", target="_top"];
    "reductions/prop:preorder" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/prop:preorder<BR/>The squashing relation as a pre-order<BR/>accepted</TD></TR><TR><TD HREF="../claims/prop-preorder.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/prop:preorder" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/prop-preorder.tex", target="_top"];
    "reductions/prop:tensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/prop:tensor<BR/>Tensor products of squashing relations<BR/>accepted</TD></TR><TR><TD HREF="../claims/prop-tensor.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/prop:tensor" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/prop-tensor.tex", target="_top"];
    "reductions/rem:intertwining" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:intertwining<BR/>Classical maps before a squasher, and<BR/>relabelling after one<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-intertwining.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:intertwining" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-intertwining.tex", target="_top"];
    "reductions/rem:obstructiondecide" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:obstructiondecide<BR/>Exact decision of the necessary<BR/>conditions<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-obstructiondecide.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:obstructiondecide" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-obstructiondecide.tex", target="_top"];
    "reductions/thm:factorization" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/thm:factorization<BR/>Equality of the physical and squashed<BR/>output states<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-factorization.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/thm:factorization" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/thm-factorization.tex", target="_top"];
  }
  "reductions/cor:blockdiag" -> "reductions/cor:sound";
  "reductions/cor:blockdiag" -> "reductions/def:sound";
  "reductions/cor:blockdiag" -> "reductions/prop:pinching";
  "reductions/cor:blockdiag" -> "reductions/prop:preorder";
  "reductions/cor:monotone" -> "reductions/thm:factorization";
  "reductions/def:joint-family" -> "reductions/def:exactadm";
  "reductions/def:joint-family" -> "reductions/lem:linear";
  "reductions/lem:linear" -> "reductions/def:squashing";
  "reductions/lem:obstructions" -> "reductions/def:squashing";
  "reductions/prop:pinching" -> "reductions/def:squashing";
  "reductions/prop:preorder" -> "reductions/def:squashing";
  "reductions/prop:preorder" -> "reductions/lem:sep";
  "reductions/prop:tensor" -> "reductions/def:squashing";
  "reductions/prop:tensor" -> "reductions/lem:sep";
  "reductions/rem:intertwining" -> "reductions/ass:tsm" [style=dashed, color="#a35f13", tooltip="assumes"];
  "reductions/rem:intertwining" -> "reductions/def:joint-family";
  "reductions/rem:intertwining" -> "reductions/lem:linear";
}
