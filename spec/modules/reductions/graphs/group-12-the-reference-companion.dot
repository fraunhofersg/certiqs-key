    "reductions/cor:companion-factor-enclosure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:companion-factor-enclosure<BR/>Factor enclosures carried to the<BR/>reference companion<BR/>implemented</TD></TR><TR><TD HREF="../claims/cor-companion-factor-enclosure.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:companion-factor-enclosure" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/cor-companion-factor-enclosure.tex", target="_top"];
