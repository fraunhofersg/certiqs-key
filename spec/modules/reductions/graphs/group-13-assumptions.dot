digraph claims {
  rankdir=LR;
  graph [label="13 Assumptions\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:round-homogeneity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:round-homogeneity<BR/>Round homogeneity of a per-round<BR/>family<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../../foundations/claims/def-round-homogeneity.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../../foundations/contract.pdf#nameddest=claim-foundations/def:round-homogeneity" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../../foundations/claims/def-round-homogeneity.tex", target="_top"];
  }
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/ass:constdecl" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:constdecl<BR/>Declared constants of the constraint<BR/>list<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-constdecl.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:constdecl" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-constdecl.tex", target="_top"];
    "reductions/ass:meas" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:meas<BR/>Each measuring party&#x27;s device as one<BR/>POVM per round<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-meas.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:meas" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-meas.tex", target="_top"];
    "reductions/ass:probe" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:probe<BR/>The station&#x27;s private setting drawn<BR/>from its own declared randomness<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-probe.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:probe" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-probe.tex", target="_top"];
    "reductions/ass:recv" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:recv<BR/>Supplier artefact whose claims hold of<BR/>the device<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-recv.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:recv" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-recv.tex", target="_top"];
    "reductions/ass:round" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:round<BR/>Round homogeneity of the physical<BR/>measurement<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-round.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:round" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-round.tex", target="_top"];
    "reductions/ass:tsm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/ass:tsm<BR/>Output-state test statistics<BR/>accepted</TD></TR><TR><TD HREF="../claims/ass-tsm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/ass:tsm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/ass-tsm.tex", target="_top"];
    "reductions/def:protocol" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:protocol<BR/>Measurement-factorizing n-round<BR/>protocol<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-protocol.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:protocol" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-protocol.tex", target="_top"];
    "reductions/rem:recv-scope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:recv-scope<BR/>What the supplier assumption is stated<BR/>of<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-recv-scope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:recv-scope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-recv-scope.tex", target="_top"];
  }
  "reductions/ass:meas" -> "reductions/def:protocol";
  "reductions/ass:round" -> "foundations/def:round-homogeneity";
  "reductions/ass:round" -> "reductions/def:protocol";
}
