digraph claims {
  rankdir=LR;
  graph [label="15 Requirements: chains, constraint slots and the licence\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/cor:entries" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:entries<BR/>The emitted constraint entries<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/cor-entries.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:entries" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/cor-entries.tex", target="_top"];
    "reductions/def:chain" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:chain<BR/>Reduction chain<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-chain.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:chain" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-chain.tex", target="_top"];
    "reductions/prop:obstruction" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/prop:obstruction<BR/>Obstruction to encoding event bounds<BR/>in classical targets<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/prop-obstruction.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/prop:obstruction" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/prop-obstruction.tex", target="_top"];
    "reductions/rem:gateweight" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:gateweight<BR/>Weight of the licence in the<BR/>consumer&#x27;s gate<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-gateweight.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:gateweight" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-gateweight.tex", target="_top"];
    "reductions/rem:notlicensed" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:notlicensed<BR/>Scope of the attack-set licence<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-notlicensed.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:notlicensed" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-notlicensed.tex", target="_top"];
    "reductions/rem:obstruction-scope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:obstruction-scope<BR/>Scope of the obstruction, and what it<BR/>forces<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/rem-obstruction-scope.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:obstruction-scope" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/rem-obstruction-scope.tex", target="_top"];
    "reductions/req:constraint-and-licence-slots" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:constraint-and-licence-slots<BR/>Constraint and licence slots on every<BR/>artefact<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-constraint-and-licence-slots.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:constraint-and-licence-slots" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-constraint-and-licence-slots.tex", target="_top"];
    "reductions/req:declared-constants-only" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:declared-constants-only<BR/>Refusal of data-dependent constants<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-declared-constants-only.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:declared-constants-only" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-declared-constants-only.tex", target="_top"];
    "reductions/req:identity-link-recorded" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:identity-link-recorded<BR/>Identity link recorded for an already-<BR/>finite receiver<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-identity-link-recorded.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:identity-link-recorded" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-identity-link-recorded.tex", target="_top"];
    "reductions/req:licence-record" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:licence-record<BR/>Content and presence of the licence<BR/>record<BR/>accepted</TD></TR><TR><TD HREF="../claims/req-licence-record.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:licence-record" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/req-licence-record.tex", target="_top"];
    "reductions/req:mixed-status-chain" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/req:mixed-status-chain<BR/>Refusal of a chain with a link that is<BR/>not exact<BR/>implemented</TD></TR><TR><TD HREF="../claims/req-mixed-status-chain.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/req:mixed-status-chain" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/req-mixed-status-chain.tex", target="_top"];
    "reductions/thm:chain" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/thm:chain<BR/>Composition of a chain<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-chain.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/thm:chain" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/thm-chain.tex", target="_top"];
    "reductions/thm:licence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/thm:licence<BR/>The attack-set licence<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/thm-licence.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/thm:licence" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/thm-licence.tex", target="_top"];
  }
  "reductions/req:constraint-and-licence-slots" -> "reductions/prop:obstruction";
  "reductions/req:constraint-and-licence-slots" -> "reductions/rem:obstruction-scope";
  "reductions/req:declared-constants-only" -> "reductions/rem:notlicensed";
  "reductions/req:identity-link-recorded" -> "reductions/def:chain";
  "reductions/req:identity-link-recorded" -> "reductions/thm:chain";
  "reductions/req:licence-record" -> "reductions/cor:entries";
  "reductions/req:licence-record" -> "reductions/rem:gateweight";
  "reductions/req:licence-record" -> "reductions/rem:notlicensed";
  "reductions/req:licence-record" -> "reductions/thm:licence";
  "reductions/req:mixed-status-chain" -> "reductions/thm:chain";
}
