digraph claims {
  rankdir=LR;
  graph [label="1 Squashing relations and their statistics\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_reductions" {
    label="reductions"; color="#cbd5df";
    "reductions/cor:pullback" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/cor:pullback<BR/>Pull-back of operator bounds<BR/>accepted</TD></TR><TR><TD HREF="../claims/cor-pullback.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/cor:pullback" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/cor-pullback.tex", target="_top"];
    "reductions/def:certificate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:certificate<BR/>Certificates of transported<BR/>constraints<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-certificate.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:certificate" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-certificate.tex", target="_top"];
    "reductions/def:msm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:msm<BR/>Measurement channel<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-msm.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:msm" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-msm.tex", target="_top"];
    "reductions/def:squashing" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:squashing<BR/>Squashing relation<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-squashing.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:squashing" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-squashing.tex", target="_top"];
    "reductions/def:system-setting" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/def:system-setting<BR/>The system setting of the reductions<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-system-setting.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/def:system-setting" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-system-setting.tex", target="_top"];
    "reductions/lem:msmfact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:msmfact<BR/>Measurement-channel factorization<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-msmfact.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:msmfact" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-msmfact.tex", target="_top"];
    "reductions/lem:sep" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:sep<BR/>Separation and tensor adjoints in the<BR/>infinite-dimensional case<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-sep.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:sep" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-sep.tex", target="_top"];
    "reductions/lem:statistics" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/lem:statistics<BR/>Squashing as statistics equivalence<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-statistics.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/lem:statistics" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-statistics.tex", target="_top"];
    "reductions/rem:carried-operators" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:carried-operators<BR/>Carried operators and the image of the<BR/>squashing channel<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-carried-operators.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:carried-operators" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-carried-operators.tex", target="_top"];
    "reductions/rem:dictionary" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:dictionary<BR/>Direction of the squashing symbol in<BR/>the literature<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-dictionary.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:dictionary" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-dictionary.tex", target="_top"];
    "reductions/rem:notchannel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">reductions/rem:notchannel<BR/>Reductions that are not squashings<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-notchannel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-reductions/rem:notchannel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-notchannel.tex", target="_top"];
  }
  "reductions/cor:pullback" -> "reductions/lem:statistics";
  "reductions/def:certificate" -> "reductions/cor:pullback";
  "reductions/def:squashing" -> "reductions/lem:sep";
  "reductions/lem:msmfact" -> "reductions/lem:sep";
  "reductions/lem:msmfact" -> "reductions/lem:statistics";
  "reductions/lem:sep" -> "reductions/def:system-setting";
  "reductions/lem:statistics" -> "reductions/def:squashing";
  "reductions/lem:statistics" -> "reductions/lem:sep";
  "reductions/rem:carried-operators" -> "reductions/def:squashing";
  "reductions/rem:dictionary" -> "reductions/def:squashing";
}
