digraph claims {
  rankdir=LR;
  graph [label="1 Quantum-information preliminaries\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:kl" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:kl<BR/>Classical divergences and the quantum<BR/>relative entropy<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-kl.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:kl" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-kl.tex", target="_top"];
    "foundations/def:pinching" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:pinching<BR/>Operator conventions and pinching<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-pinching.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:pinching" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-pinching.tex", target="_top"];
    "foundations/def:renyi" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:renyi<BR/>Sandwiched Rényi divergence and<BR/>conditional entropies<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-renyi.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:renyi" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-renyi.tex", target="_top"];
    "foundations/fact:concavity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/fact:concavity<BR/>Concavity of the pinched trace-power<BR/>functional<BR/>accepted</TD></TR><TR><TD HREF="../claims/fact-concavity.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/fact:concavity" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/fact-concavity.tex", target="_top"];
    "foundations/fact:pinch-id" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/fact:pinch-id<BR/>Pinched trace-power form of the<BR/>conditional Rényi entropy<BR/>accepted</TD></TR><TR><TD HREF="../claims/fact-pinch-id.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/fact:pinch-id" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/fact-pinch-id.tex", target="_top"];
    "foundations/lem:kernel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:kernel<BR/>Extended divergence kernel<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-kernel.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:kernel" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-kernel.tex", target="_top"];
    "foundations/lem:pinchmono" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:pinchmono<BR/>Pinching lowers the trace power<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-pinchmono.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:pinchmono" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-pinchmono.tex", target="_top"];
  }
  "foundations/fact:pinch-id" -> "foundations/def:pinching";
  "foundations/fact:pinch-id" -> "foundations/def:renyi";
  "foundations/lem:pinchmono" -> "foundations/def:pinching";
}
