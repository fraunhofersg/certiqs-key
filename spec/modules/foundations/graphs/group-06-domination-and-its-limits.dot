digraph claims {
  rankdir=LR;
  graph [label="6 Domination and its limits\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/def:domination" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:domination<BR/>Domination of one operator family by<BR/>another at block weights<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-domination.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:domination" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-domination.tex", target="_top"];
    "foundations/def:exact-reference" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:exact-reference<BR/>Reference of a measurement family,<BR/>exact or enclosed<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exact-reference.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:exact-reference" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-exact-reference.tex", target="_top"];
    "foundations/def:sector-map" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:sector-map<BR/>Sector maps and block-list operators<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-sector-map.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:sector-map" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-sector-map.tex", target="_top"];
    "foundations/lem:absorbing-domination" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:absorbing-domination<BR/>Domination of a family that absorbs<BR/>its residue in one element<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-absorbing-domination.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:absorbing-domination" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-absorbing-domination.tex", target="_top"];
    "foundations/lem:domination" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:domination<BR/>Elementary properties of domination<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-domination.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:domination" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-domination.tex", target="_top"];
    "foundations/lem:enclosure-psd" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:enclosure-psd<BR/>Positive semidefiniteness from an<BR/>entrywise enclosure<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-enclosure-psd.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:enclosure-psd" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-enclosure-psd.tex", target="_top"];
    "foundations/lem:rational-obstruction" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:rational-obstruction<BR/>Rationality obstruction to the<BR/>domination of a lattice family<BR/>accepted</TD></TR><TR><TD HREF="../claims/lem-rational-obstruction.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:rational-obstruction" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/lem-rational-obstruction.tex", target="_top"];
    "foundations/rem:noise-floor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/rem:noise-floor<BR/>What domination controls, and why it<BR/>needs a noise floor<BR/>accepted</TD></TR><TR><TD HREF="../claims/rem-noise-floor.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/rem:noise-floor" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/rem-noise-floor.tex", target="_top"];
  }
  "foundations/def:domination" -> "foundations/def:sector-map";
  "foundations/lem:absorbing-domination" -> "foundations/def:domination";
  "foundations/lem:absorbing-domination" -> "foundations/lem:domination";
  "foundations/lem:domination" -> "foundations/def:domination";
  "foundations/lem:domination" -> "foundations/def:sector-map";
  "foundations/lem:rational-obstruction" -> "foundations/def:domination";
  "foundations/lem:rational-obstruction" -> "foundations/lem:domination";
  "foundations/rem:noise-floor" -> "foundations/def:domination";
  "foundations/rem:noise-floor" -> "foundations/def:exact-reference";
  "foundations/rem:noise-floor" -> "foundations/lem:absorbing-domination";
  "foundations/rem:noise-floor" -> "foundations/lem:domination";
  "foundations/rem:noise-floor" -> "foundations/lem:rational-obstruction";
}
