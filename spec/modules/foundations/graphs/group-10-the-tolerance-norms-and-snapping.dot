  "foundations/req:tolerance-scope" -> "foundations/def:tolerance";
  "foundations/req:who-snaps" -> "foundations/def:declared-data";
  "foundations/req:who-snaps" -> "foundations/def:evaluated-off-snap";
  "foundations/req:who-snaps" -> "foundations/def:exact-reference";
