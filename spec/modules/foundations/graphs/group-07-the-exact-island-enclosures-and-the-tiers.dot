digraph claims {
  rankdir=LR;
  graph [label="7 The exact island, enclosures and the tiers\nArrow: claim -> prerequisite. Solid: uses; dashed: assumes.\nDeclared dependencies, not a proof check. Mentions excluded.", labelloc=t, fontsize=13, fontname="Arial", bgcolor="white", pad=0.25, nodesep=0.3];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, margin="0.13,0.09"];
  edge [color="#526777", arrowsize=0.65];
  subgraph "cluster_foundations" {
    label="foundations"; color="#cbd5df";
    "foundations/cor:least-eigenvalue-over-enclosure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/cor:least-eigenvalue-over-enclosure<BR/>Least eigenvalue and rank over an<BR/>enclosure<BR/>implemented</TD></TR><TR><TD HREF="../claims/cor-least-eigenvalue-over-enclosure.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/cor:least-eigenvalue-over-enclosure" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/cor-least-eigenvalue-over-enclosure.tex", target="_top"];
    "foundations/cor:rank-over-factor-enclosure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/cor:rank-over-factor-enclosure<BR/>Rank over a factor enclosure<BR/>implemented</TD></TR><TR><TD HREF="../claims/cor-rank-over-factor-enclosure.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/cor:rank-over-factor-enclosure" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/cor-rank-over-factor-enclosure.tex", target="_top"];
    "foundations/def:declared-data" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:declared-data<BR/>Declared data and the parties to a<BR/>module boundary<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-declared-data.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:declared-data" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-declared-data.tex", target="_top"];
    "foundations/def:exact-admissibility" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:exact-admissibility<BR/>Exact admissibility of a declared<BR/>operator family<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exact-admissibility.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:exact-admissibility" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-exact-admissibility.tex", target="_top"];
    "foundations/def:exact-island" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:exact-island<BR/>The exact island<BR/>accepted</TD></TR><TR><TD HREF="../claims/def-exact-island.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:exact-island" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled", URL="../claims/def-exact-island.tex", target="_top"];
    "foundations/def:exact-reference" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:exact-reference<BR/>Reference of a measurement family,<BR/>exact or enclosed<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-exact-reference.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:exact-reference" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-exact-reference.tex", target="_top"];
    "foundations/def:factor-enclosure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:factor-enclosure<BR/>Factor enclosure of a block<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-factor-enclosure.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:factor-enclosure" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-factor-enclosure.tex", target="_top"];
    "foundations/def:snap" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:snap<BR/>Snapping declared data onto a lattice<BR/>implemented<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-snap.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:snap" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled,dashed", URL="../claims/def-snap.tex", target="_top"];
    "foundations/def:tiers" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:tiers<BR/>The tiers of a reported key rate<BR/>implemented</TD></TR><TR><TD HREF="../claims/def-tiers.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:tiers" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/def-tiers.tex", target="_top"];
    "foundations/def:tolerance" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/def:tolerance<BR/>The declared tolerance and the defects<BR/>it bounds<BR/>accepted<BR/>BOUNDARY: further prerequisites omitted</TD></TR><TR><TD HREF="../claims/def-tolerance.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/def:tolerance" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#cfead0", style="rounded,filled,dashed", URL="../claims/def-tolerance.tex", target="_top"];
    "foundations/lem:least-eigenvalue-bound" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:least-eigenvalue-bound<BR/>Least-eigenvalue lower bound from an<BR/>approximate eigenbasis<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-least-eigenvalue-bound.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:least-eigenvalue-bound" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-least-eigenvalue-bound.tex", target="_top"];
    "foundations/lem:matrix-function-perturbation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD COLSPAN="2">foundations/lem:matrix-function-perturbation<BR/>Perturbation bounds for matrix<BR/>functions<BR/>implemented</TD></TR><TR><TD HREF="../claims/lem-matrix-function-perturbation.tex" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">TeX source</FONT></TD><TD HREF="../contract.pdf#nameddest=claim-foundations/lem:matrix-function-perturbation" TARGET="_top"><FONT COLOR="#164b87" POINT-SIZE="10">Rendered PDF</FONT></TD></TR></TABLE>>, fillcolor="#a9d6ab", style="rounded,filled", URL="../claims/lem-matrix-function-perturbation.tex", target="_top"];
  }
  "foundations/cor:least-eigenvalue-over-enclosure" -> "foundations/def:exact-reference";
  "foundations/cor:least-eigenvalue-over-enclosure" -> "foundations/lem:least-eigenvalue-bound";
  "foundations/cor:rank-over-factor-enclosure" -> "foundations/cor:least-eigenvalue-over-enclosure";
  "foundations/cor:rank-over-factor-enclosure" -> "foundations/def:factor-enclosure";
  "foundations/def:exact-island" -> "foundations/def:declared-data";
  "foundations/def:exact-island" -> "foundations/def:exact-admissibility";
  "foundations/def:exact-island" -> "foundations/def:exact-reference";
  "foundations/def:exact-island" -> "foundations/def:snap";
  "foundations/def:exact-island" -> "foundations/def:tolerance";
  "foundations/lem:matrix-function-perturbation" -> "foundations/cor:least-eigenvalue-over-enclosure";
}
