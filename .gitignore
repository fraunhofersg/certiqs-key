node_modules/

# Claude Code local settings
.claude/settings.local.json
# Agent worktrees, each a checkout of its own branch
.claude/worktrees/

# PDFs are tracked on purpose: each module's spec/modules/<id>/contract.pdf,
# the review copy the assembler builds after every contract revision, and in
# the maintainers' tree the pinned references (refs/papers/) and corpus notes
# (context/). Only LaTeX's auxiliary output (above) is ignored.
